+/*
+ * Site icons: the developer can replace any icon in the app (upload one, or draw it in Keyflame).
+ * Replacements live in the cloud (siteIcons collection) and everyone's app loads them when it opens.
+ * They're also kept on this device, so the loading screen and favicon can use them before the cloud answers.
+ *
+ * Icon ids:
+ *   brand:loading    the flame on the loading screen
+ *   brand:favicon    the browser tab icon
+ *   ui:<name>        any icon drawn with ToolIcon (toolbar, inspector, menus...). ui:mascotmark is the menu bar logo.
+ *   timeline:<name>  icons drawn inside the timeline (layer buttons, frame buttons, push/overwrite...)
+ *   strip:<name>     icons on the timeline tool strip
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import cloud from 'cloud/cloud';
+
+const CACHE_KEY = 'siteIconCache';
+let overrides = {};
+let listeners = new Set();
+let timelineDefaults = {}; // filled by the timeline: name -> url
+
+try { overrides = JSON.parse(window.localStorage.getItem(CACHE_KEY) || '{}') || {}; } catch (e) { overrides = {}; }
+
+export const DEFAULT_LOADING_SVG =
+  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 120'>" +
+  "<path d='M50 6 C58 30 84 46 84 76 C84 101 68 115 50 115 C32 115 16 101 16 76 C16 56 30 46 35 26 C41 40 45 46 50 52 C51 36 47 22 50 6 Z' fill='#FF8A3D' stroke='#231F20' stroke-width='6' stroke-linejoin='round'/>" +
+  "<path d='M50 62 C57 73 67 81 67 93 C67 104 59 110 50 110 C41 110 33 104 33 93 C33 81 44 75 50 62 Z' fill='#FFD23F'/></svg>";
+
+export function svgToDataUrl (svg) {
+  return 'data:image/svg+xml;base64,' + window.btoa(unescape(encodeURIComponent(svg)));
+}
+
+export function getOverride (id) { return overrides[id] || null; }
+export function allOverrides () { return Object.assign({}, overrides); }
+
+export function onIconsChange (cb) { listeners.add(cb); return () => listeners.delete(cb); }
+
+/** The timeline tells us its own icons so they can be listed and replaced. */
+export function registerTimelineIcons (map) {
+  Object.assign(timelineDefaults, map);
+  applyTimeline();
+}
+export function timelineIconDefaults () { return Object.assign({}, timelineDefaults); }
+
+function saveCache () {
+  try { window.localStorage.setItem(CACHE_KEY, JSON.stringify(overrides)); } catch (e) { /* too big or private mode: fine */ }
+}
+
+function applyTimeline () {
+  let Icons = window.Wick && window.Wick.GUIElement && window.Wick.GUIElement.Icons;
+  if (!Icons) return;
+  Object.keys(timelineDefaults).forEach(name => {
+    Icons.loadIcon(name, overrides['timeline:' + name] || timelineDefaults[name]);
+  });
+}
+
+function applyFavicon () {
+  let href = overrides['brand:favicon'];
+  let link = document.querySelector("link[rel~='icon']");
+  if (!link) { link = document.createElement('link'); link.rel = 'icon'; document.head.appendChild(link); }
+  if (!link.dataset.original) link.dataset.original = link.getAttribute('href') || '';
+  link.setAttribute('href', href || link.dataset.original);
+}
+
+function applyAll (editor) {
+  applyTimeline();
+  applyFavicon();
+  listeners.forEach(cb => { try { cb(); } catch (e) {} });
+  if (editor) {
+    editor.forceUpdate();
+    // timeline icons load as images; redraw once they're in
+    setTimeout(() => { try { editor.project.guiElement.draw(); } catch (e) {} }, 300);
+  }
+}
+
+/** Load the developer's icons from the cloud (if the cloud is set up). */
+export function loadSiteIcons (editor) {
+  applyAll(editor);
+  return cloud.enabled().then(ok => {
+    if (!ok || !cloud.listSiteIcons) return;
+    return cloud.listSiteIcons().then(list => {
+      let next = {};
+      list.forEach(x => { if (x && x.data) next[x.id] = x.data; });
+      overrides = next;
+      saveCache();
+      applyAll(editor);
+    });
+  }).catch(e => console.warn('Could not load site icons', e));
+}
+
+export async function setSiteIcon (editor, id, dataUrl) {
+  await cloud.saveSiteIcon(id, dataUrl);
+  overrides[id] = dataUrl;
+  saveCache();
+  applyAll(editor);
+}
+
+export async function resetSiteIcon (editor, id) {
+  await cloud.deleteSiteIcon(id);
+  delete overrides[id];
+  saveCache();
+  applyAll(editor);
+}
+
+/** Turn an uploaded file into a small data URL: SVGs stay vector, pictures are scaled down to 256px. */
+export function fileToIconData (file) {
+  return new Promise((resolve, reject) => {
+    let isSvg = /svg/.test(file.type) || /\.svg$/i.test(file.name);
+    let reader = new FileReader();
+    reader.onerror = () => reject(new Error('read-failed'));
+    if (isSvg) {
+      reader.onload = () => resolve(svgToDataUrl(String(reader.result)));
+      reader.readAsText(file);
+      return;
+    }
+    if (/gif/.test(file.type)) { // keep animated GIFs as they are (for the loading screen)
+      reader.onload = () => resolve(String(reader.result));
+      reader.readAsDataURL(file);
+      return;
+    }
+    reader.onload = () => {
+      let img = new Image();
+      img.onload = () => {
+        let scale = Math.min(1, 256 / Math.max(img.width, img.height));
+        let c = document.createElement('canvas');
+        c.width = Math.max(1, Math.round(img.width * scale));
+        c.height = Math.max(1, Math.round(img.height * scale));
+        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
+        resolve(c.toDataURL('image/png'));
+      };
+      img.onerror = () => reject(new Error('not-an-image'));
+      img.src = String(reader.result);
+    };
+    reader.readAsDataURL(file);
+  });
+}
