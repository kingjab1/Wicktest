+/*
+ * Touch gestures for the canvas (iPad):
+ *   - two fingers: pinch to zoom, drag to pan, twist to rotate (snaps back to straight near 0°)
+ *   - two-finger tap: undo, three-finger tap: redo
+ *   - snap to shape: draw a line, circle, triangle or rectangle with the brush or pencil, then hold
+ *     your finger still for a moment before lifting. The wobbly stroke turns into a clean shape.
+ *
+ * A single finger is held back for a split second so a second finger can join without leaving a mark.
+ * Apple Pencil strokes go straight through.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+const HOLD_BACK_MS = 70;      // how long one finger waits to see if a second one is coming
+const TAP_MAX_MS = 300;       // a quick two- or three-finger touch counts as a tap
+const TAP_MAX_MOVE = 14;      // px
+const SNAP_HOLD_MS = 550;     // hold still this long at the end of a stroke to snap it
+const SNAP_STILL_PX = 6;
+const ROTATE_START_DEG = 12;  // twist this far before the canvas starts turning
+const ROTATE_SNAP_DEG = 7;    // ends up straight if it's this close to 0°
