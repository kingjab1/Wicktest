+}
+
+.sound-rec {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding-top: 18px;
+  color: $editor-modal-text-white;
+  text-align: center;
+}
+.sound-rec-big {
+  width: 110px;
+  height: 110px;
+  border-radius: 50%;
+  border: 6px solid $editor-modal-text-white;
+  background: transparent;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  &:disabled { opacity: 0.5; }
+}
+.sound-rec-dot { width: 70px; height: 70px; border-radius: 50%; background: #ff4d4d; }
+.sound-rec-square { width: 44px; height: 44px; border-radius: 8px; background: #ff4d4d; }
+.sound-rec-stop { animation: sound-rec-pulse 1.2s ease-in-out infinite; }
+@keyframes sound-rec-pulse {
+  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 77, 77, 0.5); }
+  50% { box-shadow: 0 0 0 14px rgba(255, 77, 77, 0); }
+}
+.sound-rec-label { margin-top: 12px; font-size: 16px; }
+.sound-rec-time { margin-top: 10px; font-size: 28px; font-weight: bold; font-variant-numeric: tabular-nums; }
+.sound-rec-meter {
+  width: 220px;
+  height: 10px;
+  border-radius: 5px;
+  background: $editor-modal-dark;
+  margin-top: 8px;
+  overflow: hidden;
+  div { height: 100%; background: $editor-green-highlight; transition: width 0.08s linear; }
+}
+.sound-rec-result { width: 100%; max-width: 460px; }
+.sound-rec-name {
+  flex: 1;
+  min-width: 0;
+  background: $editor-primary;
+  color: $editor-modal-text-white;
+  border: 2px solid transparent;
+  border-radius: 8px;
+  padding: 6px 8px;
+  font-size: 16px;
+  margin: 0 8px;
+  &:focus { outline: none; border-color: $editor-green-highlight; }
+}
+.sound-rec-actions { display: flex; gap: 10px; justify-content: center; margin-top: 14px; flex-wrap: wrap; }
+.sound-rec-add { background: $editor-green-highlight; color: $editor-primary; }
+.sound-rec-again {
+  height: 40px;
+  padding: 0 14px;
+  border-radius: 8px;
+  border: 2px solid $editor-modal-text-white;
+  background: transparent;
+  color: $editor-modal-text-white;
+  font-weight: bold;
+  font-size: 15px;
+  cursor: pointer;
+}
+.sound-rec-error {
+  background: #5a2a2a;
+  color: #ffd6d6;
+  border-radius: 8px;
+  padding: 8px 12px;
+  margin-bottom: 14px;
+  max-width: 520px;
+}
+.sound-rec-note { font-size: 17px; max-width: 520px; margin-bottom: 12px; }
+.sound-rec-tip { font-size: 13px; color: $editor-modal-text-gray; margin-top: 18px; max-width: 520px; }
