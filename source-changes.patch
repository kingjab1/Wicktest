+  }
+
+  uploadSound = (e) => {
+    let file = e.target.files && e.target.files[0];
+    e.target.value = '';
+    if (!file) return;
+    let name = this.state.soundName.trim() || file.name.replace(/\.[^.]+$/, '');
+    let url = URL.createObjectURL(file);
+    let seconds = new Promise(resolve => {
+      let a = new Audio();
+      a.onloadedmetadata = () => resolve(isFinite(a.duration) ? Math.round(a.duration * 10) / 10 : 1);
+      a.onerror = () => resolve(1);
+      a.src = url;
+      setTimeout(() => resolve(1), 4000);
+    });
+    this.run(() => seconds.then(s => cloud.uploadClassSound({ name: name, seconds: s, blob: file })), 'Added "' + name + '" to Class Sounds.')
+      .then(() => { URL.revokeObjectURL(url); this.setState({ soundName: '' }); this.loadSounds(); })
+      .catch(() => URL.revokeObjectURL(url));
+  }
+
+  stopSound = () => {
+    this.playingId = null;
+    if (this.audio) { this.audio.pause(); this.audio = null; }
+    if (this.audioUrl) { URL.revokeObjectURL(this.audioUrl); this.audioUrl = null; }
+    if (this.state.playing) this.setState({ playing: null });
+  }
+
+  playSound = (s) => {
+    if (this.playingId === s.id) { this.stopSound(); return; }
+    this.stopSound();
+    // Start a silent clip inside the tap so iPad Safari allows the real sound once it downloads.
+    let a = new Audio('data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=');
+    this.audio = a; this.playingId = s.id;
+    this.setState({ playing: s.id });
+    a.onended = () => { if (this.audio === a && this.audioUrl) this.stopSound(); };
+    a.play().catch(() => {});
+    cloud.loadClassSound(s.id).then(blob => {
+      if (this.audio !== a) return;
+      this.audioUrl = URL.createObjectURL(blob);
+      a.src = this.audioUrl;
+      a.play().catch(() => { if (this.audio === a) this.stopSound(); });
+    }).catch(() => { if (this.audio === a) this.stopSound(); });
+  }
+
+  deleteSound = (s) => {
+    let key = 'sound:' + s.id;
+    if (this.state.confirmDelete !== key) { this.setState({ confirmDelete: key }); return; }
+    this.run(() => cloud.deleteClassSound(s.id), 'Removed "' + s.name + '".')
