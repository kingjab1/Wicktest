diff --git a/src/Editor/Modals/SoundLibrary/SoundLibrary.jsx b/src/Editor/Modals/SoundLibrary/SoundLibrary.jsx
new file mode 100644
index 0000000..31b16d1
--- /dev/null
+++ b/src/Editor/Modals/SoundLibrary/SoundLibrary.jsx
@@ -0,0 +1,127 @@
+/*
+ * Sound Effects: a library of free-to-share sounds students can preview and
+ * drop onto their animation. The list is fetched from /sounds/catalog.json.
+ *
+ * "Add" puts the sound on a layer named "Sounds" at the playhead, making the
+ * layer and a frame long enough for the sound if they don't exist yet.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import React, { Component } from 'react';
+import WickModal from 'Editor/Modals/WickModal/WickModal';
+
+import './_soundlibrary.scss';
+
+class SoundLibrary extends Component {
+  constructor (props) {
+    super(props);
+    this.state = { catalog: null, error: false, category: null, playing: null, adding: null };
+    this.audio = null;
+  }
+
+  static get ROOT () {
+    return process.env.PUBLIC_URL + '/sounds/';
+  }
+
+  componentDidUpdate (prevProps) {
+    if (this.props.open && !prevProps.open && !this.state.catalog) this.loadCatalog();
+    if (!this.props.open && prevProps.open) this.stop();
+  }
+
+  loadCatalog = () => {
+    fetch(SoundLibrary.ROOT + 'catalog.json?t=' + Date.now())
+      .then(resp => { if (!resp.ok) throw new Error('HTTP ' + resp.status); return resp.json(); })
+      .then(catalog => this.setState({ catalog: catalog, error: false, category: (catalog.categories || [])[0] || null }))
+      .catch(e => { console.error('SoundLibrary:', e); this.setState({ error: true }); });
+  }
+
+  stop = () => {
+    if (this.audio) { this.audio.pause(); this.audio = null; }
+    if (this.state.playing) this.setState({ playing: null });
+  }
+
+  togglePlay = (sound) => {
+    if (this.state.playing === sound.file) { this.stop(); return; }
+    this.stop();
+    let audio = new Audio(SoundLibrary.ROOT + sound.file);
+    audio.onended = () => { if (this.audio === audio) this.stop(); };
+    this.audio = audio;
+    this.setState({ playing: sound.file });
+    let p = audio.play();
+    if (p && p.catch) p.catch(e => { console.error(e); this.stop(); });
+  }
+
+  add = (sound) => {
+    if (this.state.adding) return;
+    this.setState({ adding: sound.file });
+    fetch(SoundLibrary.ROOT + sound.file)
+      .then(resp => { if (!resp.ok) throw new Error('HTTP ' + resp.status); return resp.blob(); })
+      .then(blob => {
+        let file = new File([blob], sound.file.split('/').pop(), { type: 'audio/mpeg' });
+        this.props.addLibrarySound(file, sound.name, sound.seconds || 1);
+      })
+      .catch(e => {
+        console.error('SoundLibrary add:', e);
+        this.props.toast('Could not download that sound. Check your internet connection.', 'error');
+      })
+      .then(() => this.setState({ adding: null }));
+  }
+
+  renderSound = (sound) => {
+    let playing = this.state.playing === sound.file;
+    let adding = this.state.adding === sound.file;
+    return (
+      <div key={sound.file} className={'sound-lib-item' + (playing ? ' sound-lib-item-playing' : '')}>
+        <button className='sound-lib-play' aria-label={(playing ? 'Stop ' : 'Play ') + sound.name} onClick={() => this.togglePlay(sound)}>
+          {playing ? '■' : '▶'}
+        </button>
+        <div className='sound-lib-name' onClick={() => this.togglePlay(sound)}>
+          {sound.name}
+          <span className='sound-lib-length'>{sound.seconds < 1 ? 'short' : Math.round(sound.seconds) + 's'}</span>
+        </div>
+        <button className='sound-lib-add' disabled={adding} onClick={() => this.add(sound)}>
+          {adding ? '...' : 'Add'}
+        </button>
+      </div>
+    );
+  }
+
+  renderBody = () => {
+    let { catalog, error, category } = this.state;
+    if (error) return <div className='sound-lib-empty'>Couldn't load the sounds. Check your internet connection and try again.</div>;
+    if (!catalog) return <div className='sound-lib-empty'>Loading...</div>;
+    let list = catalog.sounds.filter(s => s.category === category);
+    return (
+      <React.Fragment>
+        <div className='sound-lib-categories'>
+          {catalog.categories.map(c =>
+            <button key={c} className={'sound-lib-category' + (c === category ? ' sound-lib-category-active' : '')}
+              onClick={() => { this.stop(); this.setState({ category: c }); }}>
+              {c}
+            </button>)}
+        </div>
+        <div className='sound-lib-list'>{list.map(this.renderSound)}</div>
+      </React.Fragment>
+    );
+  }
+
+  render () {
+    return (
+      <WickModal
+        open={this.props.open}
+        toggle={this.props.toggle}
+        className='modal-body sound-lib-modal-body'
+        overlayClassName='modal-overlay sound-lib-modal-overlay'>
+        <div className='sound-lib'>
+          <div className='sound-lib-title'>Sound Effects</div>
+          <div className='sound-lib-hint'>Move the playhead to where the sound should start, then tap Add.</div>
+          {this.renderBody()}
+        </div>
+      </WickModal>
+    );
+  }
+}
+
+export default SoundLibrary;
