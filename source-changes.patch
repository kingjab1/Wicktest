+  font-size: 16px;
+  font-weight: bold;
+  color: $editor-modal-text-white;
+  padding: 8px 10px 2px 10px;
+}
+
+.learn-card-description {
+  font-size: 13px;
+  color: $editor-modal-text-dark;
+  padding: 2px 10px;
+}
+
+.learn-chips {
+  display: flex;
+  flex-wrap: wrap;
+  padding: 6px 8px 10px 8px;
+}
+
+.learn-chip {
+  border: 1px solid $editor-modal-gray-secondary;
+  background: transparent;
+  color: $editor-modal-text-gray;
+  font-size: 12px;
+  border-radius: 12px;
+  padding: 3px 9px;
+  margin: 2px;
+  cursor: pointer;
+}
+
+.learn-chip-active {
+  background: $editor-green-highlight;
+  border-color: $editor-green-highlight;
+  color: $editor-primary;
+}
+
+.learn-chip-tag {
+  cursor: default;
+  border-style: dashed;
+}
+
+.learn-filter-bar {
+  margin-bottom: 10px;
+  font-size: 14px;
+}
+
+.learn-link {
+  border: none;
+  background: transparent;
+  color: $editor-green-highlight;
+  font-size: 14px;
+  font-weight: bold;
+  padding: 4px 8px;
+  cursor: pointer;
+}
+
+.learn-empty {
+  padding: 40px 10px;
+  text-align: center;
+  color: $editor-modal-text-dark;
+  font-size: 16px;
+}
+
+.learn-principle {
