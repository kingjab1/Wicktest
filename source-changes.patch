diff --git a/src/Editor/Modals/MyWork/IconsPanel.jsx b/src/Editor/Modals/MyWork/IconsPanel.jsx
new file mode 100644
index 0000000..71d4c4a
--- /dev/null
+++ b/src/Editor/Modals/MyWork/IconsPanel.jsx
@@ -0,0 +1,156 @@
+/*
+ * Developer only: every icon in the app, with Upload, Draw (in Keyflame) and Reset.
+ * Saved icons change for everyone the next time their app opens.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import React, { Component } from 'react';
+import ReactDOMServer from 'react-dom/server';
+import { icons as uiIcons } from '../../Util/ToolIcon/ToolIcon';
+import { Icon as StripIcon, STRIP_ICONS } from '../../Panels/Timeline/TimelineTools/TimelineTools';
+import { getOverride, onIconsChange, setSiteIcon, resetSiteIcon, fileToIconData, timelineIconDefaults,
+  svgToDataUrl, DEFAULT_LOADING_SVG } from '../../Icons/siteIcons';
+import cloud from 'cloud/cloud';
+
+const DRAWING_TOOLS = ['cursor', 'brush', 'pencil', 'eraser', 'rectangle', 'ellipse', 'line', 'pathcursor', 'text',
+  'fillbucket', 'eyedropper', 'pan', 'zoom', 'zoomin', 'zoomout', 'undo', 'redo', 'delete', 'copy', 'paste', 'recenter'];
+
+const TIMELINE_NAMES = {
+  hide_layer: 'Layer shown (eye)', show_layer: 'Layer hidden (eye)', lock_layer: 'Layer unlocked', unlock_layer: 'Layer locked',
+  guide_layer: 'Guide layer', guides_on: 'Guides while playing: on', guides_off: 'Guides while playing: off',
+  mode_push_on: 'Push: on', mode_push_off: 'Push: off', mode_overwrite_on: 'Overwrite: on', mode_overwrite_off: 'Overwrite: off',
+  copy_frame_forward: 'Copy frame forward', cut_frame: 'Add frame', delete_frame: 'Delete', add_tween: 'Add tween',
+  small_frames: 'Small frames', normal_frames: 'Normal frames', large_frames: 'Large frames', frame_size_menu: 'Frame size',
+  gap_fill_menu_blank_frames: 'Gap fill: blank frames', gap_fill_menu_extend_frames: 'Gap fill: extend frames',
+  gap_fill_empty_frames: 'Gap fill menu: blank', gap_fill_extend_frames: 'Gap fill menu: extend',
+};
+
+function niceName (name) {
+  return name.replace(/[-_]/g, ' ').replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, c => c.toUpperCase());
+}
+
+/** Everything that can be replaced, in groups. Each entry: { id, label, src (default picture) or render (default JSX) } */
+export function iconRegistry () {
+  let ui = Object.keys(uiIcons);
+  let groups = [
+    { title: 'Brand', items: [
+      { id: 'brand:loading', label: 'Loading screen', src: svgToDataUrl(DEFAULT_LOADING_SVG), note: 'An animated GIF works here too' },
+      { id: 'ui:mascotmark', label: 'Menu bar logo', src: uiIcons.mascotmark },
+      { id: 'brand:favicon', label: 'Browser tab icon', src: (process.env.PUBLIC_URL || '') + '/favicon.ico' },
+    ] },
+    { title: 'Drawing tools', items: DRAWING_TOOLS.filter(n => uiIcons[n]).map(n => ({ id: 'ui:' + n, label: niceName(n), src: uiIcons[n] })) },
+    { title: 'Timeline tool strip', items: Object.keys(STRIP_ICONS).map(n => ({ id: 'strip:' + n, label: STRIP_ICONS[n], render: n })) },
+    { title: 'Timeline', items: Object.keys(timelineIconDefaults()).map(n => ({ id: 'timeline:' + n, label: TIMELINE_NAMES[n] || niceName(n), src: timelineIconDefaults()[n] })) },
+    { title: 'Everything else', items: ui.filter(n => DRAWING_TOOLS.indexOf(n) === -1 && n !== 'mascotmark').map(n => ({ id: 'ui:' + n, label: niceName(n), src: uiIcons[n] })) },
+  ];
+  return groups;
+}
+
+/** The default picture as SVG text if it is one (so it can be opened as a drawing), else null. */
+export async function defaultSvgText (item) {
+  if (item.render) {
+    return ReactDOMServer.renderToStaticMarkup(<StripIcon name={item.render} size={64} />)
+      .replace(/currentColor/g, '#e8e8e8');
+  }
+  let src = getOverride(item.id) || item.src;
+  if (!src) return null;
+  if (/^data:image\/svg\+xml;base64,/.test(src)) return decodeURIComponent(escape(window.atob(src.split(',')[1])));
+  if (/^data:image\/svg\+xml/.test(src)) return decodeURIComponent(src.split(',')[1]);
+  if (/\.svg(\?|$)/i.test(src)) {
+    let res = await fetch(src);
+    return res.ok ? res.text() : null;
+  }
+  return null;
+}
+
+class IconsPanel extends Component {
+  constructor (props) {
+    super(props);
+    this.state = { filter: '', busy: null, confirmReset: null };
+  }
+
+  componentDidMount () { this.off = onIconsChange(() => this.forceUpdate()); }
+  componentWillUnmount () { if (this.off) this.off(); }
+
+  upload = (item, file) => {
+    if (!file) return;
+    this.setState({ busy: item.id });
+    fileToIconData(file)
+      .then(data => setSiteIcon(window.editor, item.id, data))
+      .then(() => this.props.toast('Saved the new ' + item.label + ' icon. Everyone gets it next time their app opens.', 'success'))
+      .catch(e => this.props.toast(cloud.message(e), 'error'))
+      .then(() => this.setState({ busy: null }));
+  }
+
+  reset = (item) => {
+    this.setState({ busy: item.id, confirmReset: null });
+    resetSiteIcon(window.editor, item.id)
+      .then(() => this.props.toast('Put the ' + item.label + ' icon back to the original.', 'success'))
+      .catch(e => this.props.toast(cloud.message(e), 'error'))
+      .then(() => this.setState({ busy: null }));
+  }
+
+  draw = (item) => {
+    this.setState({ busy: item.id });
+    defaultSvgText(item).catch(() => null).then(svg => {
+      this.setState({ busy: null });
+      this.props.close();
+      window.editor.startIconDrawing(item, svg);
+    });
+  }
+
+  renderPreview (item) {
+    let custom = getOverride(item.id);
+    if (custom) return <img src={custom} alt='' />;
+    if (item.render) return <span className='mywork-icon-strip'><StripIcon name={item.render} size={32} /></span>;
+    return <img src={item.src} alt='' />;
+  }
+
+  render () {
+    let f = this.state.filter.trim().toLowerCase();
+    let groups = iconRegistry().map(g => Object.assign({}, g, {
+      items: g.items.filter(it => !f || it.label.toLowerCase().indexOf(f) !== -1 || it.id.toLowerCase().indexOf(f) !== -1),
+    })).filter(g => g.items.length);
+    return (
+      <div className='mywork-scroll'>
+        <p className='mywork-hint'>
+          Replace any icon in Keyflame for everyone: upload a picture (SVG is best, PNG and GIF work too) or draw it here.
+          Icons marked <b>custom</b> are yours. Reset puts the original back.
+        </p>
+        <input className='mywork-input mywork-icon-filter' placeholder='Find an icon…' value={this.state.filter}
+          onChange={e => this.setState({ filter: e.target.value })} aria-label='Find an icon' />
+        {groups.map(g =>
+          <div key={g.title}>
+            <div className='mywork-heading mywork-subheading'>{g.title}</div>
+            <div className='mywork-icon-grid'>
+              {g.items.map(it => {
+                let custom = !!getOverride(it.id);
+                let busy = this.state.busy === it.id;
+                return (
+                  <div key={it.id} className={'mywork-icon-tile' + (custom ? ' mywork-icon-custom' : '')}>
+                    <div className='mywork-icon-preview'>{this.renderPreview(it)}</div>
+                    <div className='mywork-icon-label' title={it.id}>{it.label}{custom && <span className='mywork-icon-tag'>custom</span>}</div>
+                    {it.note && <div className='mywork-icon-note'>{it.note}</div>}
+                    <div className='mywork-icon-actions'>
+                      <label className={'mywork-small mywork-file-button' + (busy ? ' mywork-disabled' : '')}>
+                        Upload
+                        <input type='file' accept='image/svg+xml,image/png,image/jpeg,image/webp,image/gif,.svg'
+                          disabled={busy} onChange={e => { let file = e.target.files[0]; e.target.value = ''; this.upload(it, file); }} />
+                      </label>
+                      <button className='mywork-small' disabled={busy} onClick={() => this.draw(it)}>Draw</button>
+                      {custom && (this.state.confirmReset === it.id
+                        ? <button className='mywork-small mywork-danger' disabled={busy} onClick={() => this.reset(it)}>Sure?</button>
+                        : <button className='mywork-small' disabled={busy} onClick={() => this.setState({ confirmReset: it.id })}>Reset</button>)}
+                    </div>
+                  </div>);
+              })}
+            </div>
+          </div>)}
+      </div>
+    );
+  }
+}
+
+export default IconsPanel;
