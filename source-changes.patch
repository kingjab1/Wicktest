+@import 'Editor/_wickbrand.scss';
+
+.sound-lib-modal-body {
+  width: 760px;
+  height: 580px;
+  max-width: 94vw;
+  max-height: 88vh;
+  padding: 0px;
+}
+
+.sound-lib {
+  width: 100%;
+  height: 100%;
+  padding: 4px 0 0 0;
+  display: flex;
+  flex-direction: column;
+  text-align: left;
+  color: $editor-modal-text-gray;
+}
+
+.sound-lib-title {
+  font-size: 20px;
+  font-weight: bold;
+  color: $editor-modal-text-white;
+  padding-right: 36px;
+}
+
+.sound-lib-hint {
+  font-size: 14px;
+  margin: 4px 0 12px 0;
+}
+
+.sound-lib-categories {
+  display: flex;
+  flex-wrap: wrap;
+  margin-bottom: 10px;
+}
+
+.sound-lib-category {
+  border: none;
+  background: $editor-modal-dark;
+  color: $editor-modal-text-white;
+  font-size: 15px;
+  font-weight: bold;
+  padding: 8px 14px;
+  margin: 0 8px 8px 0;
+  border-radius: 18px;
+  cursor: pointer;
+}
+
+.sound-lib-category-active {
+  background: $editor-green-highlight;
+  color: $editor-primary;
+}
+
+.sound-lib-list {
+  flex: 1;
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  grid-gap: 8px;
+  align-content: start;
+  padding-right: 4px;
+}
+
+.sound-lib-item {
+  display: flex;
+  align-items: center;
+  background: $editor-modal-dark;
+  border-radius: 10px;
+  padding: 6px;
+  border: 2px solid transparent;
+}
+
+.sound-lib-item-playing {
+  border-color: $editor-green-highlight;
+}
+
+.sound-lib-play {
+  flex: none;
+  width: 44px;
+  height: 44px;
+  border-radius: 50%;
+  border: none;
+  background: $editor-green-highlight;
+  color: $editor-primary;
+  font-size: 16px;
+  cursor: pointer;
+}
+
+.sound-lib-name {
+  flex: 1;
+  color: $editor-modal-text-white;
+  font-size: 15px;
+  padding: 0 8px;
+  cursor: pointer;
+  line-height: 1.2;
+}
+
+.sound-lib-length {
+  display: block;
+  font-size: 12px;
+  color: $editor-modal-text-gray;
+}
+
+.sound-lib-add {
+  flex: none;
+  height: 40px;
+  padding: 0 14px;
+  border-radius: 8px;
+  border: 2px solid $editor-green-highlight;
+  background: transparent;
+  color: $editor-green-highlight;
+  font-weight: bold;
+  font-size: 15px;
+  cursor: pointer;
+}
+
+.sound-lib-add:disabled {
+  opacity: 0.5;
+}
+
+.sound-lib-empty {
+  padding: 40px 0;
+  text-align: center;
+  font-size: 16px;
+}
+
+.sound-lib-category-class {
+  border: 2px solid $editor-green-highlight;
+}
+
+/* The Builtin Library (Asset Library + button) uses the sound panel's size. */
+.builtin-library-modal .builtin-library {
+  display: flex;
+  flex-direction: column;
+  padding: 18px 20px 12px 20px;
+}
+.builtin-library-modal .tabbed-interface {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+.builtin-library-modal .tabbed-interface-body {
+  flex: 1;
+  min-height: 0;
+  height: auto;
+  overflow: hidden;
+}
+.builtin-library-modal .builtin-library-asset-grid {
+  height: 100%;
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+}
+
+/* Record tab */
+.sound-lib-category-record {
+  display: inline-flex;
+  align-items: center;
+}
+.sound-lib-rec-dot {
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: #ff4d4d;
+  margin-right: 7px;
+  display: inline-block;
+}
+
+.sound-rec {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding-top: 18px;
+  color: $editor-modal-text-white;
+  text-align: center;
+}
+.sound-rec-big {
+  width: 110px;
+  height: 110px;
+  border-radius: 50%;
+  border: 6px solid $editor-modal-text-white;
+  background: transparent;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  &:disabled { opacity: 0.5; }
+}
+.sound-rec-dot { width: 70px; height: 70px; border-radius: 50%; background: #ff4d4d; }
+.sound-rec-square { width: 44px; height: 44px; border-radius: 8px; background: #ff4d4d; }
+.sound-rec-stop { animation: sound-rec-pulse 1.2s ease-in-out infinite; }
+@keyframes sound-rec-pulse {
+  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 77, 77, 0.5); }
+  50% { box-shadow: 0 0 0 14px rgba(255, 77, 77, 0); }
+}
+.sound-rec-label { margin-top: 12px; font-size: 16px; }
+.sound-rec-time { margin-top: 10px; font-size: 28px; font-weight: bold; font-variant-numeric: tabular-nums; }
+.sound-rec-meter {
+  width: 220px;
+  height: 10px;
+  border-radius: 5px;
+  background: $editor-modal-dark;
+  margin-top: 8px;
