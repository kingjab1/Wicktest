+/*
+ * Sound Effects: a library of sounds students can preview and drop onto their
+ * animation. It's the Sounds tab of the Builtin Library (the + button in the
+ * Asset Library). The list is fetched from /sounds/catalog.json. Students who
+ * are signed in also get "Class Sounds", which their teacher uploads.
+ *
+ * "Add" puts the sound on a layer named "Sounds" at the playhead, making the
+ * layer and a frame long enough for the sound if they don't exist yet.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import React, { Component } from 'react';
+import cloud from 'cloud/cloud';
+import SoundRecorder from './SoundRecorder';
+
+import './_soundlibrary.scss';
+
+const CLASS_SOUNDS = 'Class Sounds';
+const RECORD = 'Record';
+// A tiny silent WAV, played inside the tap so iPad Safari allows the real sound after it loads.
+const SILENCE = 'data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=';
+
+class SoundLibrary extends Component {
+  constructor (props) {
+    super(props);
+    this.state = { catalog: null, error: false, category: null, playing: null, adding: null, classSounds: null, classError: false };
+    this.audio = null;
+    this.audioUrl = null;
+  }
+
+  static get ROOT () {
+    return process.env.PUBLIC_URL + '/sounds/';
+  }
+
+  componentDidMount () {
+    this.loadCatalog();
+    this.unsub = null;
+    cloud.enabled().then(on => {
+      if (on && !this.unmounted) this.unsub = cloud.onUserChange(user => this.loadClassSounds(user));
+    });
+  }
+
+  componentWillUnmount () {
+    this.unmounted = true;
+    this.stop();
+    if (this.unsub) this.unsub();
+  }
+
+  loadCatalog = () => {
+    fetch(SoundLibrary.ROOT + 'catalog.json?t=' + Date.now())
+      .then(resp => { if (!resp.ok) throw new Error('HTTP ' + resp.status); return resp.json(); })
+      .then(catalog => { if (!this.unmounted) this.setState({ catalog: catalog, error: false, category: this.state.category || (catalog.categories || [])[0] || null }); })
+      .catch(e => { console.error('SoundLibrary:', e); if (!this.unmounted) this.setState({ error: true }); });
+  }
+
+  loadClassSounds = (user) => {
+    if (this.unmounted) return;
+    if (!user || (user.role !== 'student' && user.role !== 'teacher')) {
+      this.setState({ classSounds: null, category: this.state.category === CLASS_SOUNDS ? null : this.state.category });
+      return;
+    }
+    cloud.listClassSounds()
+      .then(list => { if (!this.unmounted) this.setState({ classSounds: list, classError: false }); })
+      .catch(e => { console.error('Class sounds:', e); if (!this.unmounted) this.setState({ classSounds: [], classError: true }); });
+  }
+
+  defaultCategory = () => {
+    let cats = (this.state.catalog && this.state.catalog.categories) || [];
+    return cats[0] || RECORD;
+  }
+
+  categories = () => {
+    let cats = (this.state.catalog && this.state.catalog.categories) || [];
+    return [RECORD].concat(this.state.classSounds ? [CLASS_SOUNDS] : [], cats);
+  }
+
+  key = (sound) => sound.id ? 'class:' + sound.id : sound.file;
+
+  // Class sounds come from the save server; everything else is a file on this site.
+  getBlob = (sound) => {
+    if (sound.id) return cloud.loadClassSound(sound.id);
+    return fetch(SoundLibrary.ROOT + sound.file).then(resp => { if (!resp.ok) throw new Error('HTTP ' + resp.status); return resp.blob(); });
+  }
+
+  stop = () => {
+    this.playingKey = null;
+    if (this.audio) { this.audio.pause(); this.audio = null; }
+    if (this.audioUrl) { URL.revokeObjectURL(this.audioUrl); this.audioUrl = null; }
+    if (this.state.playing && !this.unmounted) this.setState({ playing: null });
+  }
+
+  togglePlay = (sound) => {
+    let k = this.key(sound);
+    if (this.playingKey === k) { this.stop(); return; }
+    this.stop();
+    // The audio element is made and started inside the tap itself: iPad Safari only
+    // lets sound start from a tap, and only on an element the tap already played.
+    let audio = new Audio();
+    this.audio = audio;
+    this.playingKey = k;
+    this.setState({ playing: k });
+    let real = !sound.id;
+    audio.onended = () => { if (real && this.audio === audio) this.stop(); };
+    let play = () => {
+      let p = audio.play();
+      if (p && p.catch) p.catch(e => {
+        if (e && e.name === 'AbortError') return; // a newer load replaced this one
+        console.error('Sound preview:', e);
+        if (this.audio === audio) this.stop();
+      });
+    };
+    if (sound.id) {
+      audio.src = SILENCE;
+      let p = audio.play();
+      if (p && p.catch) p.catch(() => {});
+      this.getBlob(sound).then(blob => {
+        if (this.audio !== audio) return;
+        this.audioUrl = URL.createObjectURL(blob);
+        real = true;
+        audio.src = this.audioUrl;
+        play();
+      }).catch(() => { if (this.audio === audio) this.stop(); });
+    } else {
+      audio.src = SoundLibrary.ROOT + sound.file;
+      play();
+    }
+  }
+
+  add = (sound) => {
+    if (this.state.adding) return;
+    let k = this.key(sound);
+    this.setState({ adding: k });
+    this.getBlob(sound)
+      .then(blob => {
+        let type = blob.type || sound.type || 'audio/mpeg';
+        let ext = sound.file ? sound.file.split('.').pop() : (/wav/.test(type) ? 'wav' : /ogg/.test(type) ? 'ogg' : /mp4|m4a|aac/.test(type) ? 'm4a' : 'mp3');
+        let filename = sound.file ? sound.file.split('/').pop() : sound.name.replace(/[^\w\- ]+/g, '').trim().replace(/\s+/g, '-').toLowerCase() + '.' + ext;
+        let file = new File([blob], filename, { type: type });
+        this.props.addLibrarySound(file, sound.name, sound.seconds || 1);
+      })
+      .catch(e => {
+        console.error('SoundLibrary add:', e);
+        this.props.toast('Could not download that sound. Check your internet connection.', 'error');
+      })
+      .then(() => { if (!this.unmounted) this.setState({ adding: null }); });
+  }
+
+  renderSound = (sound) => {
+    let k = this.key(sound);
+    let playing = this.state.playing === k;
+    let adding = this.state.adding === k;
+    return (
+      <div key={k} className={'sound-lib-item' + (playing ? ' sound-lib-item-playing' : '')}>
+        <button className='sound-lib-play' aria-label={(playing ? 'Stop ' : 'Play ') + sound.name} onClick={() => this.togglePlay(sound)}>
+          {playing ? '■' : '▶'}
+        </button>
+        <div className='sound-lib-name' onClick={() => this.togglePlay(sound)}>
+          {sound.name}
+          <span className='sound-lib-length'>{sound.seconds < 1 ? 'short' : Math.round(sound.seconds) + 's'}</span>
+        </div>
+        <button className='sound-lib-add' disabled={adding} onClick={() => this.add(sound)}>
+          {adding ? '...' : 'Add'}
+        </button>
+      </div>
+    );
+  }
+
+  renderList = () => {
+    let { catalog, classSounds, classError } = this.state;
+    let category = this.state.category || this.defaultCategory();
+    if (category === RECORD) {
+      return <SoundRecorder addLibrarySound={this.props.addLibrarySound} toast={this.props.toast} />;
+    }
+    if (category === CLASS_SOUNDS) {
+      if (classError) return <div className='sound-lib-empty'>Couldn't load Class Sounds. Check the Wi-Fi and try again.</div>;
+      if (!classSounds || classSounds.length === 0) return <div className='sound-lib-empty'>Your teacher hasn't added any class sounds yet.</div>;
+      return <div className='sound-lib-list'>{classSounds.map(this.renderSound)}</div>;
+    }
+    return <div className='sound-lib-list'>{catalog.sounds.filter(s => s.category === category).map(this.renderSound)}</div>;
+  }
+
+  render () {
+    let { catalog, error, category } = this.state;
+    return (
+      <div className='sound-lib'>
+        <div className='sound-lib-hint'>Move the playhead to where the sound should start, then tap Add.</div>
+        {error && <div className='sound-lib-empty'>Couldn't load the sounds. Check your internet connection and try again.</div>}
+        {!error && !catalog && <div className='sound-lib-empty'>Loading...</div>}
+        {!error && catalog &&
+          <React.Fragment>
+            <div className='sound-lib-categories'>
+              {this.categories().map(c =>
+                <button key={c} className={'sound-lib-category' + (c === (category || this.defaultCategory()) ? ' sound-lib-category-active' : '') + (c === CLASS_SOUNDS ? ' sound-lib-category-class' : '') + (c === RECORD ? ' sound-lib-category-record' : '')}
+                  onClick={() => { this.stop(); this.setState({ category: c }); }}>
+                  {c === RECORD ? <React.Fragment><span className='sound-lib-rec-dot' />Record</React.Fragment> : c}
+                </button>)}
+            </div>
+            {this.renderList()}
+          </React.Fragment>}
+      </div>
+    );
+  }
+}
+
+export default SoundLibrary;
