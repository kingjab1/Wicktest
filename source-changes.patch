+  for (let i = 1; i < pts.length - 1; i++) {
+    let d = distToSegment(pts[i], pts[0], pts[pts.length - 1]);
+    if (d > maxD) { maxD = d; idx = i; }
+  }
+  if (maxD <= eps) return [pts[0], pts[pts.length - 1]];
+  let left = simplify(pts.slice(0, idx + 1), eps);
+  let right = simplify(pts.slice(idx), eps);
