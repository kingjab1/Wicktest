+    q = opts && opts.classId
+      ? q.where('classId', '==', opts.classId).where('teacher', '==', currentUser.uid)
+      : q.where('owner', '==', currentUser.uid);
+    let snap = await q.get();
+    return snap.docs.map(d => {
+      let x = d.data();
+      return { id: d.id, title: x.title, thumb: x.thumb, owner: x.owner, label: x.label, size: x.size, updatedAt: tsToMillis(x.updatedAt) };
+    }).filter(p => p.updatedAt || p.size).sort((a, b) => b.updatedAt - a.updatedAt);
+  },
+
+  /** Saves a project. Pass id to overwrite one of your own. Returns the id. */
+  async saveProject ({ id, title, thumb, blob }) {
+    if (B()) return B().saveProject({ id, title, thumb, blob });
+    let ref = id ? db.collection('projects').doc(id) : db.collection('projects').doc();
+    let meta = { owner: currentUser.uid, title: title || 'Untitled', thumb: thumb || null,
+      classId: currentUser.classId || null, label: currentUser.label || 'Teacher',
+      teacher: currentUser.role === 'student' ? currentUser.teacher : currentUser.uid };
+    return writeChunked(ref, meta, blob);
+  },
+
+  loadProject (id) { return B() ? B().loadProject(id) : readChunked(db.collection('projects').doc(id)); },
+  deleteProject (id) { return B() ? B().deleteProject(id) : deleteChunked(db.collection('projects').doc(id)); },
+
+  /* ----- Learn (the developer publishes, everyone reads) ----- */
+
+  async listLearn () {
+    if (B()) return B().listLearn();
+    let snap = await db.collection('learn').get();
+    return snap.docs.map(d => Object.assign({ id: 'cloud-' + d.id, cloudId: d.id }, d.data(), { updatedAt: tsToMillis(d.data().updatedAt) }))
+      .filter(x => x.chunkCount > 0)
+      .sort((a, b) => (a.order || 0) - (b.order || 0) || a.title.localeCompare(b.title));
+  },
+
+  async publishLearn ({ cloudId, title, description, principles, tags, preview, blob, order }) {
+    if (B()) return B().publishLearn({ cloudId, title, description, principles, tags, preview, blob, order });
+    let ref = cloudId ? db.collection('learn').doc(cloudId) : db.collection('learn').doc(slug(title).slice(0, 40) + '-' + randomId(4));
+    let meta = { title, description: description || '', principles: principles || [], tags: tags || [], preview: preview || null, order: order || 0 };
+    return writeChunked(ref, meta, blob);
+  },
+
+  async updateLearnInfo (cloudId, info) {
+    if (B()) return B().updateLearnInfo(cloudId, info);
+    await db.collection('learn').doc(cloudId).update(info);
+  },
+
+  loadLearn (cloudId) { return B() ? B().loadLearn(cloudId) : readChunked(db.collection('learn').doc(cloudId)); },
+  deleteLearn (cloudId) { return B() ? B().deleteLearn(cloudId) : deleteChunked(db.collection('learn').doc(cloudId)); },
+
+  /* ----- Class Sounds (a teacher uploads them for their own students) ----- */
+
+  async listClassSounds () {
+    if (B()) return B().listClassSounds();
+    let teacher = currentUser && (currentUser.role === 'student' ? currentUser.teacher : currentUser.uid);
+    if (!teacher) return [];
+    let snap = await db.collection('classSounds').where('teacher', '==', teacher).get();
+    return snap.docs.map(d => Object.assign({ id: d.id }, d.data()))
+      .filter(x => x.chunkCount > 0)
+      .sort((a, b) => String(a.name).localeCompare(String(b.name)));
+  },
+
+  async uploadClassSound ({ name, seconds, blob }) {
+    if (B()) return B().uploadClassSound({ name, seconds, blob });
+    let ref = db.collection('classSounds').doc(slug(name).slice(0, 40) + '-' + randomId(4));
+    return writeChunked(ref, { teacher: currentUser.uid, name: name, seconds: seconds || 1, type: blob.type || 'audio/mpeg' }, blob);
+  },
+
+  loadClassSound (id) { return B() ? B().loadClassSound(id) : readChunked(db.collection('classSounds').doc(id)); },
+  deleteClassSound (id) { return B() ? B().deleteClassSound(id) : deleteChunked(db.collection('classSounds').doc(id)); },
+
+  /* ----- which online project is open in the editor ----- */
+
+  /** Remembers that the editor's project (by its uuid) came from online project `id`. */
+  setOpenProject (projectUuid, id, title) { this._open = id ? { projectUuid, id, title } : null; },
+  openProjectFor (projectUuid) { return this._open && this._open.projectUuid === projectUuid ? this._open : null; },
+
+  /** Turns Firebase error codes into something a student or teacher can act on. */
+  message (e) {
+    let code = (e && (e.code || e.message)) || '';
+    if (/no-class/.test(code)) return "There's no class with that code. Check the code on your card and try again.";
+    if (/wrong-password|invalid-credential|invalid-login|user-not-found|not-found/.test(code)) return "That didn't match. Try again, or ask your teacher.";
+    if (/too-many-requests/.test(code)) return 'Too many tries. Wait a minute, then try again.';
+    if (/network|unavailable|failed-precondition|deadline/.test(code)) return "Couldn't reach the save server. Check the Wi-Fi and try again.";
+    if (/permission-denied/.test(code)) return "This account isn't allowed to do that.";
+    if (/too-big/.test(code)) return 'This project is too big to save online (over 15 MB). Try removing big sounds or images.';
+    if (/email-already-in-use/.test(code)) return 'That email already has an account. Sign in instead.';
+    if (/weak-password/.test(code)) return 'Use a password with at least 6 characters.';
+    if (/invalid-email/.test(code)) return "That email address doesn't look right.";
+    return 'Something went wrong (' + code + ').';
+  },
+};
+
+window.wickCloud = cloud;
+export default cloud;
