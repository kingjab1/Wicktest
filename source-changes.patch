+  let buffer = [];
+  let timer = null;
+  let replaying = new WeakSet();
+  let canReplay = true;
+  let g = null;       // gesture info
+  let stroke = null;  // points of the current stroke, for snap to shape
+  let snapTimer = null;
+
+  const project = () => editor.project;
+  const paperView = () => project() && project().view && project().view.paper && project().view.paper.view;
+  const container = () => project() && project().view && project().view.canvasContainer;
+  const inCanvas = (target) => {
+    let c = container();
+    return !!(c && target && target.nodeType === 1 && c.contains(target) && target.tagName === 'CANVAS');
+  };
+  const isStylus = (t) => t && t.touchType === 'stylus';
+  const block = (e) => { e.stopImmediatePropagation(); if (e.cancelable) e.preventDefault(); };
+  const playing = () => editor.state && editor.state.previewPlaying;
+
+  /* ----- holding back one finger ----- */
+
+  function flush () {
+    clearTimeout(timer);
+    timer = null;
+    let events = buffer;
+    buffer = [];
+    state = 'drawing';
+    for (let ev of events) {
+      try {
+        replaying.add(ev);
+        ev.target.dispatchEvent(ev);
+      } catch (err) {
+        // This browser won't re-send touches; stop holding them back from now on.
+        canReplay = false;
+        console.warn('Touch replay not supported', err);
+        break;
+      }
+    }
+  }
