+@import 'Editor/_wickbrand.scss';
+
+.learn-modal-body {
+  width: 860px;
+  height: 600px;
+  max-width: 94vw;
+  max-height: 88vh;
+  padding: 0px;
+}
+
+.learn {
+  width: 100%;
+  height: 100%;
+  padding: 18px 20px 10px 20px;
+  display: flex;
+  flex-direction: column;
+  color: $editor-modal-text-gray;
+  text-align: left;
+}
+
+.learn-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 12px;
+  padding-right: 36px; // room for the modal close button
+}
+
+.learn-title {
+  font-size: 20px;
+  font-weight: bold;
+  color: $editor-modal-text-white;
+}
+
+.learn-tabs {
+  display: flex;
