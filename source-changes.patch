+  /* ----- two-finger view changes ----- */
+
+  function fingers (touches) {
+    let list = Array.from(touches).slice(0, 2);
+    let pv = paperView();
+    let rect = pv.element.getBoundingClientRect();
+    let a = { x: list[0].clientX - rect.left, y: list[0].clientY - rect.top };
+    let b = list[1] ? { x: list[1].clientX - rect.left, y: list[1].clientY - rect.top } : a;
+    return {
+      cx: (a.x + b.x) / 2, cy: (a.y + b.y) / 2,
+      dist: Math.max(1, Math.hypot(b.x - a.x, b.y - a.y)),
