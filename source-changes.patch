+
+  /** Turns Firebase error codes into something a student or teacher can act on. */
+  message (e) {
+    let code = (e && (e.code || e.message)) || '';
+    if (/no-class/.test(code)) return "There's no class with that code. Check the code on your card and try again.";
+    if (/wrong-password|invalid-credential|invalid-login|user-not-found|not-found/.test(code)) return "That didn't match. Try again, or ask your teacher.";
+    if (/popup-closed-by-user|cancelled-popup-request/.test(code)) return null;
+    if (/popup-blocked/.test(code)) return 'The Google window was blocked. Allow pop-ups for this site and try again.';
+    if (/unauthorized-domain/.test(code)) return "Google sign-in isn't allowed on this website address yet (add it under Authorized domains in Firebase).";
+    if (/operation-not-allowed/.test(code)) return "That sign-in method isn't turned on yet.";
+    if (/account-exists-with-different-credential/.test(code)) return 'That email already signs in a different way. Use email and password instead.';
+    if (/too-many-requests/.test(code)) return 'Too many tries. Wait a minute, then try again.';
+    if (/network|unavailable|failed-precondition|deadline/.test(code)) return "Couldn't reach the save server. Check the Wi-Fi and try again.";
+    if (/permission-denied/.test(code)) return "This account isn't allowed to do that.";
+    if (/too-big/.test(code)) return 'This project is too big to save online (over 15 MB). Try removing big sounds or images.';
+    if (/email-already-in-use/.test(code)) return 'That email already has an account. Sign in instead.';
+    if (/weak-password/.test(code)) return 'Use a password with at least 6 characters.';
+    if (/invalid-email/.test(code)) return "That email address doesn't look right.";
+    return 'Something went wrong (' + code + ').';
+  },
