+@import 'Editor/_wickbrand.scss';
+
+#animation-timeline-container { position: relative; }
+
+.timeline-tools {
+  position: absolute;
+  top: 2px;
+  right: 6px;
+  z-index: 2;
+  height: 26px;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  max-width: calc(100% - 190px);
+  overflow-x: auto;
+  scrollbar-width: none;
+  &::-webkit-scrollbar { display: none; }
+}
+
+/* Each group sits on one dark pill so related buttons read as a set. */
+.tt-group {
+  display: flex;
+  align-items: center;
+  gap: 1px;
+  flex: none;
+  padding: 1px;
+  border-radius: 7px;
+  background: rgba(0, 0, 0, 0.25);
+}
+
+.tt-btn {
+  height: 24px;
+  min-width: 26px;
+  padding: 0 5px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  border: none;
+  border-radius: 6px;
+  background: transparent;
+  color: $editor-modal-text-white;
+  font-size: 12px;
+  font-weight: bold;
+  white-space: nowrap;
+  cursor: pointer;
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+  &:hover { background: rgba(255, 255, 255, 0.08); }
+  &:active { background: $editor-green-highlight-dark; color: $editor-primary; }
+  &:focus { outline: none; }
+  &:focus-visible { box-shadow: 0 0 0 2px $editor-green-highlight; }
+}
+
+.tt-svg { flex: none; display: block; }
+.tt-named { padding: 0 7px 0 5px; }
+.tt-name { line-height: 24px; }
+
+.tt-seg {
+  display: inline-flex;
+  margin-left: 3px;
+  border-radius: 6px;
+  background: rgba(255, 255, 255, 0.06);
+}
+
+.tt-on { background: $editor-green-highlight; color: $editor-primary; &:hover { background: $editor-green-highlight; } }
+.tt-loop { color: #c9b8ff; }
+
+.tt-editing-group { background: rgba(177, 151, 252, 0.18); padding-left: 6px; }
+.tt-editing {
+  font-size: 12px;
+  font-weight: bold;
+  color: #c9b8ff;
+  white-space: nowrap;
+  padding-right: 4px;
+}
+.tt-done { background: $editor-green-highlight; color: $editor-primary; padding: 0 10px; &:hover { background: $editor-green-highlight; } }
+
+.tt-clear { min-width: 20px; padding: 0 4px; font-size: 11px; opacity: 0.8; }
+
+/* Play range number boxes */
+.tt-range-box {
+  width: 30px;
+  height: 22px;
+  margin: 0 1px;
+  padding: 0 2px;
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  border-radius: 5px;
+  background: rgba(0, 0, 0, 0.35);
+  color: $editor-modal-text-white;
+  font: bold 12px 'Nunito Sans', sans-serif;
+  text-align: center;
+  -webkit-user-select: text;
+  user-select: text;
+  &::placeholder { color: rgba(255, 255, 255, 0.35); }
+  &:focus { outline: none; border-color: $editor-green-highlight; }
+}
+
+/* Push / Overwrite at the bottom left, next to the gap fill and frame size buttons */
+.tt-mode-bottom {
+  position: absolute;
+  left: 76px;
+  bottom: 31px;
+  z-index: 2;
+  display: flex;
+  gap: 1px;
+  padding: 1px;
+  border-radius: 5px;
+  background: rgba(255, 255, 255, 0.06);
+}
+.tt-mini {
+  width: 28px;
+  height: 17px;
+  padding: 0;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: none;
+  border-radius: 4px;
+  background: transparent;
+  color: $editor-modal-text-white;
+  cursor: pointer;
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+  .tt-svg { width: 14px; height: 14px; }
+  &.tt-on { background: $editor-green-highlight; color: $editor-primary; }
+}
+
+/* ⋯ menu */
+.tt-menu {
+  position: fixed;
+  z-index: 900;
+  min-width: 240px;
+  padding: 10px 12px 12px;
+  border-radius: 10px;
+  background: $editor-tertiary;
+  color: $editor-modal-text-white;
+  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
+  font-family: 'Nunito Sans', sans-serif;
+  font-size: 14px;
+}
+.tt-menu-title { font-weight: bold; font-size: 15px; margin-bottom: 6px; }
+.tt-menu-sub { font-size: 12px; opacity: 0.7; margin: 10px 0 2px; }
+.tt-menu-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 32px;
+  margin: 0;
+  cursor: pointer;
+  input { width: 18px; height: 18px; margin: 0; accent-color: $editor-green-highlight; }
+}
+.tt-menu-check { display: flex; align-items: center; gap: 8px; flex: 1; margin: 0; cursor: pointer; }
+.tt-menu-move {
+  width: 30px;
+  height: 28px;
+  border: none;
+  border-radius: 6px;
+  background: rgba(255, 255, 255, 0.1);
+  color: inherit;
+  font-size: 18px;
+  line-height: 1;
+  cursor: pointer;
+  &:disabled { opacity: 0.25; cursor: default; }
+}
+.tt-menu-icon { display: inline-flex; width: 18px; justify-content: center; opacity: 0.85; }
+.tt-menu-reset {
+  margin-top: 8px;
+  height: 30px;
+  padding: 0 12px;
+  border: none;
+  border-radius: 6px;
+  background: rgba(255, 255, 255, 0.1);
+  color: inherit;
+  font: inherit;
+  font-weight: bold;
+  cursor: pointer;
+}
