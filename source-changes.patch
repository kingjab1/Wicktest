index 0000000..d0d3df6
--- /dev/null
+++ b/src/Editor/Modals/MyWork/MyWork.jsx
@@ -0,0 +1,761 @@
+/*
+ * My Work: student logins (class + picture + PIN), online saves, and teacher
+ * mode (classes, login cards, Learn publishing, Class Sounds).
+ *
+ * Everything goes through src/cloud/cloud.js. If the site has no
+ * cloud-config.json, this modal says online saving isn't set up.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import React, { Component } from 'react';
+import WickModal from 'Editor/Modals/WickModal/WickModal';
+import cloud from 'cloud/cloud';
+
+import './_mywork.scss';
+
+function when (ms) {
+  if (!ms) return '';
+  let d = new Date(ms);
+  let today = new Date();
+  if (d.toDateString() === today.toDateString()) return 'Today ' + d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+  return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
+}
+
+function Picture ({ label, size }) {
+  let p = cloud.pictureFor(label);
+  return (
+    <span className='mywork-pic' style={{ background: p.color, width: size || 56, height: size || 56, fontSize: (size || 56) * 0.6 }}>
+      {p.emoji}
+    </span>
+  );
+}
+
+class MyWork extends Component {
+  constructor (props) {
+    super(props);
+    this.state = {
+      enabled: null,
+      user: null,
+      busy: false,
+      error: null,
+      // signing in
+      step: 'class', cls: null, codeInput: '', label: null, pin: '', titleTaps: 0,
+      email: '', password: '', newTeacherUid: null,
+      // signed in
+      tab: 'work', projects: null, saveTitle: '', confirmDelete: null,
+      // teacher
+      teacherClasses: null, selectedClass: null, pins: {}, newClassName: '', addCount: 5,
+      classProjects: null, learnItems: null, principles: [],
+      learnForm: { cloudId: null, title: '', description: '', principles: [], replaceFile: true },
+      sounds: null, soundName: '', playing: null,
+    };
+    this.audio = null;
+  }
+
+  componentDidMount () {
+    cloud.enabled().then(on => {
+      this.setState({ enabled: !!on });
+      if (on) this.unsub = cloud.onUserChange(user => this.setState({ user: user }, () => this.props.open && this.refresh()));
+    });
+  }
+
+  componentWillUnmount () {
+    if (this.unsub) this.unsub();
+  }
+
+  componentDidUpdate (prevProps) {
+    if (this.props.open && !prevProps.open) {
+      this.setState({ error: null, confirmDelete: null, saveTitle: this.props.getProjectName ? this.props.getProjectName() : '' });
+      if (/^#dev(eloper)?$/i.test(window.location.hash || '') && !this.state.user) this.setState({ step: 'developer' });
+      this.refresh();
+    }
+    if (!this.props.open && prevProps.open) this.stopSound();
+  }
+
+  /* ---------- helpers ---------- */
+
+  run = (fn, okMessage) => {
+    this.setState({ busy: true, error: null });
+    return Promise.resolve()
+      .then(fn)
+      .then(r => { this.setState({ busy: false }); if (okMessage) this.props.toast(okMessage, 'success'); return r; })
+      .catch(e => { console.error(e); this.setState({ busy: false, error: cloud.message(e) }); throw e; });
+  }
+
+  refresh = () => {
+    let user = this.state.user;
+    if (!this.state.enabled) return;
+    if (!user) return;
+    if (user.role === 'student' || user.role === 'teacher') this.loadProjects();
+    if (user.role === 'teacher') {
+      this.loadTeacherClasses();
+      if (this.state.tab === 'learn' && user.admin) this.loadLearn();
+      if (this.state.tab === 'sounds') this.loadSounds();
+    }
+  }
+
+  setTab = (tab) => {
+    this.setState({ tab: tab, error: null, confirmDelete: null }, () => {
+      if (tab === 'learn') this.loadLearn();
+      if (tab === 'sounds') this.loadSounds();
+      if (tab === 'classes') this.loadTeacherClasses();
+      if (tab === 'work') this.loadProjects();
+    });
+  }
+
+  /* ---------- sign in ---------- */
+
+  /** Class codes this iPad has used, newest first, so students only type theirs once. */
+  recentClasses () {
+    try { return JSON.parse(window.localStorage.getItem('recentClasses') || '[]').slice(0, 4); } catch (e) { return []; }
+  }
+
+  rememberClass (cls) {
+    try {
+      let list = this.recentClasses().filter(c => c.code !== cls.id);
+      list.unshift({ code: cls.id, name: cls.name });
+      window.localStorage.setItem('recentClasses', JSON.stringify(list.slice(0, 4)));
+    } catch (e) { /* private browsing */ }
+  }
+
+  forgetClass = (code) => {
+    try {
+      window.localStorage.setItem('recentClasses', JSON.stringify(this.recentClasses().filter(c => c.code !== code)));
+    } catch (e) {}
+    this.forceUpdate();
+  }
+
+  openClass = (code) => {
+    this.run(() => cloud.getClassByCode(code)).then(cls => {
+      if (!cls) { this.setState({ error: cloud.message({ code: 'no-class' }) }); return; }
+      this.rememberClass(cls);
+      this.setState({ cls: cls, step: 'pick', codeInput: '', error: null });
+    }).catch(() => {});
+  }
+
+  submitCode = (e) => {
+    e.preventDefault();
+    if (cloud.normalizeCode(this.state.codeInput)) this.openClass(this.state.codeInput);
+  }
+
+  /** Tapping the title 5 times opens the developer sign-in. */
+  tapTitle = () => {
+    let now = Date.now();
+    let taps = now - (this.lastTitleTap || 0) < 1500 ? this.state.titleTaps + 1 : 1;
+    this.lastTitleTap = now;
+    if (taps >= 5 && !this.state.user) {
+      this.setState({ titleTaps: 0, step: 'developer', error: null });
+    } else {
+      this.setState({ titleTaps: taps });
+    }
+  }
+  pickLabel = (label) => this.setState({ label: label, step: 'pin', pin: '', error: null });
+
+  pressKey = (k) => {
+    if (this.state.busy) return;
+    if (k === 'back') { this.setState({ pin: this.state.pin.slice(0, -1), error: null }); return; }
+    let pin = (this.state.pin + k).slice(0, 4);
+    this.setState({ pin: pin, error: null });
+    if (pin.length === 4) {
+      this.run(() => cloud.studentSignIn(this.state.cls.id, this.state.label, pin))
+        .then(() => this.setState({ step: 'class', pin: '', tab: 'work' }))
+        .catch(() => this.setState({ pin: '' }));
+    }
+  }
+
+  teacherSignIn = (e) => {
+    e.preventDefault();
+    let developer = this.state.step === 'developer';
+    this.run(() => cloud.teacherSignIn(this.state.email.trim(), this.state.password))
+      .then(() => this.setState({ password: '', step: 'class', tab: 'work', devCheck: developer })).catch(() => {});
+  }
+
+  teacherCreate = (e) => {
+    e.preventDefault();
+    this.run(() => cloud.teacherCreateAccount(this.state.email.trim(), this.state.password), 'Your teacher account is ready.')
+      .then(() => this.setState({ password: '', step: 'class', tab: 'classes' }, this.refresh)).catch(() => {});
+  }
+
+  signOut = () => {
+    this.run(() => cloud.signOut()).then(() => {
+      cloud.setOpenProject(null, null);
+      this.setState({ step: 'class', cls: null, label: null, projects: null, teacherClasses: null,
+        selectedClass: null, classProjects: null, tab: 'work' }, this.refresh);
+    }).catch(() => {});
+  }
+
+  /* ---------- my work ---------- */
+
+  loadProjects = () => {
+    cloud.listProjects().then(p => this.setState({ projects: p })).catch(e => this.setState({ error: cloud.message(e) }));
+  }
+
+  save = (asNew) => {
+    let title = (this.state.saveTitle || '').trim() || 'Untitled';
+    let saved;
+    this.run(() => this.props.getProjectForCloud(title).then(p => {
+      let open = asNew ? null : cloud.openProjectFor(p.uuid);
+      return cloud.saveProject({ id: open ? open.id : null, title: title, thumb: p.thumb, blob: p.blob })
+        .then(id => { saved = { id, uuid: p.uuid }; });
+    }), 'Saved "' + title + '" to My Work.').then(() => {
+      cloud.setOpenProject(saved.uuid, saved.id, title);
+      this.loadProjects();
+    }).catch(() => {});
+  }
+
+  openProject = (p, own) => {
+    this.run(() => cloud.loadProject(p.id)).then(blob => {
+      this.props.toggle();
+      this.props.openCloudProject(blob, { id: p.id, title: p.title, own: own });
+    }).catch(() => {});
+  }
+
+  deleteProject = (p) => {
+    if (this.state.confirmDelete !== p.id) { this.setState({ confirmDelete: p.id }); return; }
+    this.run(() => cloud.deleteProject(p.id), 'Deleted "' + p.title + '".').then(() => {
+      this.setState({ confirmDelete: null });
+      this.loadProjects();
+      if (this.state.selectedClass) this.loadClassProjects(this.state.selectedClass);
+    }).catch(() => {});
+  }
+
+  /* ---------- teacher: classes ---------- */
+
+  loadTeacherClasses = () => {
+    cloud.listClasses().then(c => {
+      this.setState({ teacherClasses: c });
+      let sel = this.state.selectedClass;
+      if (sel && !c.find(x => x.id === sel)) this.setState({ selectedClass: null });
+    }).catch(e => this.setState({ error: cloud.message(e) }));
+  }
+
+  selectClass = (id) => {
+    this.setState({ selectedClass: id, pins: {}, classProjects: null, confirmDelete: null });
