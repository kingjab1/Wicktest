+    let info = { title: title, description: f.description.trim(), principles: f.principles };
+    let job;
+    if (f.cloudId && !f.replaceFile) {
+      job = () => cloud.updateLearnInfo(f.cloudId, info);
+    } else {
+      job = () => this.props.getProjectForCloud().then(p =>
+        cloud.publishLearn(Object.assign({ cloudId: f.cloudId, preview: p.thumb, blob: p.blob }, info)));
+    }
+    this.run(job, f.cloudId ? 'Updated "' + title + '" in Learn.' : 'Published "' + title + '" to Learn.')
+      .then(() => { this.editLearn(null); this.loadLearn(); }).catch(() => {});
