+    return (
+      <div className='mywork-scroll'>
+        <div className='mywork-hint'>Sounds here show up as "Class Sounds" in the sound library, only for students in your classes.</div>
+        <div className='mywork-row'>
+          <input className='mywork-input' placeholder='Name (optional)' value={soundName} maxLength={50}
+            onChange={e => this.setState({ soundName: e.target.value })} />
+          <label className={'mywork-primary mywork-file' + (busy ? ' mywork-disabled' : '')}>
+            Choose a sound
+            <input type='file' accept='audio/*' disabled={busy} onChange={this.uploadSound} />
+          </label>
+        </div>
+        {busy && <div className='mywork-status'>Uploading...</div>}
+        {!sounds && <div className='mywork-empty'>Loading...</div>}
+        {sounds && sounds.length === 0 && <div className='mywork-empty'>No class sounds yet.</div>}
+        <div className='mywork-sound-list'>
+          {(sounds || []).map(s => {
+            let confirming = confirmDelete === 'sound:' + s.id;
+            return (
+              <div key={s.id} className='mywork-sound'>
+                <button className='mywork-play' onClick={() => this.playSound(s)}>{playing === s.id ? '■' : '▶'}</button>
+                <span className='mywork-sound-name'>{s.name}</span>
+                <span className='mywork-card-meta'>{s.seconds < 1 ? 'short' : Math.round(s.seconds) + 's'}</span>
+                <button className={'mywork-small mywork-danger' + (confirming ? ' mywork-confirm' : '')} onClick={() => this.deleteSound(s)}>
+                  {confirming ? 'Tap to remove' : 'Remove'}
+                </button>
+              </div>
+            );
+          })}
+        </div>
+      </div>
+    );
+  }
+
+  renderSignedIn () {
+    let { user, tab, devCheck } = this.state;
+    if (user.role === 'none') return this.renderAccountProblem(user.uid);
+    let teacher = user.role === 'teacher';
+    let admin = teacher && user.admin;
+    if (tab === 'learn' && !admin) tab = 'work';
+    let tabButton = (id, label) =>
+      <button key={id} className={'mywork-tab' + (tab === id ? ' mywork-tab-active' : '')} onClick={() => this.setTab(id)}>{label}</button>;
+    return (
+      <React.Fragment>
+        {devCheck && teacher && !admin &&
+          <div className='mywork-error'>
+            This account isn't a developer account yet. In the Firebase console, add a collection called <b>admins</b> with a
+            document whose ID is <span className='mywork-inline-code'>{user.uid}</span> (any one field), then sign in again.
+            <button className='mywork-small' style={{ marginLeft: 8 }} onClick={() => this.setState({ devCheck: false })}>OK</button>
+          </div>}
+        <div className='mywork-userbar'>
+          {teacher ? <span className={'mywork-teacher-badge' + (admin ? ' mywork-dev-badge' : '')}>{admin ? 'Developer' : 'Teacher'}</span> : <Picture label={user.label} size={36} />}
+          <span className='mywork-username'>{teacher ? user.email : user.label}</span>
+          {teacher && <div className='mywork-tabs'>
+            {tabButton('work', 'My Work')}{tabButton('classes', 'Classes')}{tabButton('sounds', 'Class Sounds')}{admin && tabButton('learn', 'Learn (everyone)')}
+          </div>}
+          <button className='mywork-link mywork-signout' onClick={this.signOut}>Sign out</button>
+        </div>
+        {(!teacher || tab === 'work') && this.renderWork()}
+        {teacher && tab === 'classes' && this.renderClasses()}
+        {admin && tab === 'learn' && this.renderLearn()}
+        {teacher && tab === 'sounds' && this.renderSounds()}
+      </React.Fragment>
+    );
+  }
+
+  renderBody () {
+    if (this.state.enabled === null) return <div className='mywork-empty'>Loading...</div>;
+    if (!this.state.enabled) return <div className='mywork-empty'>Online saving isn't set up on this site yet. Use Save to download your project instead.</div>;
+    return this.state.user ? this.renderSignedIn() : this.renderSignIn();
+  }
+
+  render () {
+    return (
+      <WickModal
+        open={this.props.open}
+        toggle={this.props.toggle}
+        className='modal-body mywork-modal-body'
+        overlayClassName='modal-overlay mywork-modal-overlay'>
+        <div className='mywork'>
+          <div className='mywork-title' onClick={this.tapTitle}>My Work</div>
+          {this.state.error && <div className='mywork-error'>{this.state.error}</div>}
+          {this.renderBody()}
+        </div>
+      </WickModal>
+    );
+  }
+}
+
+export default MyWork;
