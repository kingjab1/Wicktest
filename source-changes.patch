+  let rx = (Math.max.apply(null, lx) - Math.min.apply(null, lx)) / 2;
+  let ry = (Math.max.apply(null, ly) - Math.min.apply(null, ly)) / 2;
+  let ox = (Math.max.apply(null, lx) + Math.min.apply(null, lx)) / 2, oy = (Math.max.apply(null, ly) + Math.min.apply(null, ly)) / 2;
+  let err = local.reduce((sum, p) => sum + Math.abs(Math.hypot((p.x - ox) / Math.max(rx, 1), (p.y - oy) / Math.max(ry, 1)) - 1), 0) / local.length;
+  // The same kind of measure for the oval, so the two can be compared (a diamond shouldn't become a circle).
+  let ovalErr = err * ((rx + ry) / 2) / size;
+  if (polygon && (err >= 0.15 || polygonErr <= ovalErr)) return polygon;
+  if (err < 0.15) {
+    let deg = angle * 180 / Math.PI;
+    let center = { x: cx + ox * Math.cos(angle) - oy * Math.sin(angle), y: cy + ox * Math.sin(angle) + oy * Math.cos(angle) };
+    if (Math.abs(rx - ry) < Math.max(rx, ry) * 0.12) { let r = (rx + ry) / 2; rx = r; ry = r; deg = 0; }
+    if (Math.abs(deg) < 8 || Math.abs(Math.abs(deg) - 90) < 8) {
+      if (Math.abs(Math.abs(deg) - 90) < 8) { let t = rx; rx = ry; ry = t; }
+      deg = 0;
+    }
+    return { type: 'ellipse', center: center, radius: [rx, ry], rotation: deg };
+  }
+
+  // Anything else: keep the shape, just tidy and close it.
+  if (polygon) return polygon;
+  return { type: 'smooth', points: pts, closed: true, size: size };
+}
+
+function circleThrough (a, b, c) {
+  let d = 2 * (a.x * (b.y - c.y) + b.x * (c.y - a.y) + c.x * (a.y - b.y));
+  if (Math.abs(d) < 1e-6) return null;
+  let a2 = a.x * a.x + a.y * a.y, b2 = b.x * b.x + b.y * b.y, c2 = c.x * c.x + c.y * c.y;
+  let x = (a2 * (b.y - c.y) + b2 * (c.y - a.y) + c2 * (a.y - b.y)) / d;
+  let y = (a2 * (c.x - b.x) + b2 * (a.x - c.x) + c2 * (b.x - a.x)) / d;
+  return { x: x, y: y, r: Math.hypot(a.x - x, a.y - y) };
+}
