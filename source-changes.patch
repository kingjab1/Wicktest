+  let closed = span < size * 0.3 || span < length * 0.12;
+
+  if (!closed) {
+    // An arc: the points sit on one circle through the start, middle and end.
+    let mid = pts[Math.floor(pts.length / 2)];
+    let c = circleThrough(first, mid, last);
+    if (c && c.r < size * 4) {
+      let off = pts.reduce((m, p) => Math.max(m, Math.abs(dist(p, c) - c.r)), 0);
+      if (off < Math.max(4, c.r * 0.12)) return { type: 'arc', from: first, through: mid, to: last };
+    }
+    return { type: 'smooth', points: pts, closed: false, size: size };
+  }
+
+  // Straight-sided shapes: find the corners, then check that every side really is straight.
+  let loop = pts.concat([first]);
+  let corners = simplify(loop, size * 0.1);
+  if (corners.length > 1 && dist(corners[0], corners[corners.length - 1]) < size * 0.2) corners.pop();
+  corners = corners.filter((c, i) => i === 0 || dist(c, corners[i - 1]) > size * 0.15);
+  let polygon = null, polygonErr = Infinity;
+  if (corners.length === 3 || corners.length === 4) {
+    let idx = corners.map(c => loop.indexOf(c));
+    let straight = idx.every((start, n) => {
+      let end = n + 1 < idx.length ? idx[n + 1] : loop.length - 1;
+      let a = loop[start], b = loop[end];
+      return end > start && edgeBend(loop, start, end) < Math.max(5, dist(a, b) * 0.1);
+    });
+    if (straight) {
+      polygon = { type: 'polygon', points: corners };
+      if (corners.length === 4) {
+        let square = corners.every((c, i) => {
+          let n = corners[(i + 1) % 4];
+          let ang = Math.abs(Math.atan2(n.y - c.y, n.x - c.x) * 180 / Math.PI) % 90;
+          return ang < 12 || ang > 78;
+        });
+        if (square) polygon.points = [{ x: minX, y: minY }, { x: maxX, y: minY }, { x: maxX, y: maxY }, { x: minX, y: maxY }];
+      }
+      // How far the stroke sits from the shape's sides, on average, as a share of its size.
+      let pp = polygon.points;
+      polygonErr = pts.reduce((sum, p) => sum + Math.min.apply(null, pp.map((c, i) => distToSegment(p, c, pp[(i + 1) % pp.length]))), 0) / pts.length / size;
+    }
+    if (typeof window === 'undefined' && process.env.SNAPDEBUG) console.log('   polygonErr', polygonErr.toFixed(3));
+    if (polygonErr > 0.03) polygon = null; // the sides bow out too much to be a straight-sided shape
+  }
+
+  // Ovals, tilted the way they were drawn.
+  let cx = xs.reduce((a, b) => a + b, 0) / pts.length, cy = ys.reduce((a, b) => a + b, 0) / pts.length;
+  let sxx = 0, syy = 0, sxy = 0;
+  pts.forEach(p => { sxx += (p.x - cx) ** 2; syy += (p.y - cy) ** 2; sxy += (p.x - cx) * (p.y - cy); });
