+  /**
+   * Open a Learn example as a fresh copy, after a reminder to save current work.
+   * Layers named "Notes" or "Annotations" are locked so students don't draw on them by accident.
+   */
+  openLearnExample = (exercise) => {
+    this.openWarningModal({
+      title: 'Open "' + exercise.title + '"?',
+      description: "The example opens as a new project. Save your current project first if you want to keep it.",
+      acceptText: "Open Example",
+      cancelText: "Cancel",
+      acceptAction: () => {
+        this.showWaitOverlay('Opening example...');
+        let download = exercise.cloudId
+          ? window.wickCloud.loadLearn(exercise.cloudId)
+          : fetch(process.env.PUBLIC_URL + '/learn/' + exercise.file).then(resp => {
+              if (!resp.ok) throw new Error('HTTP ' + resp.status);
+              return resp.blob();
+            });
+        download
+          .then(blob => {
+            window.Wick.WickFile.fromWickFile(blob, project => {
+              if (!project) {
+                this.hideWaitOverlay();
+                this.toast('Could not open that example.', 'error');
+                return;
+              }
+              project.root.timeline.layers.forEach(layer => {
+                if (/^\s*(notes?|annotations?)\s*$/i.test(layer.name || '')) layer.locked = true;
+              });
+              this.setupNewProject(project);
+              this.toast('Opened "' + exercise.title + '". Save to keep your own copy.', 'success');
+            }, 'blob');
+          })
+          .catch(e => {
+            console.error('openLearnExample:', e);
+            this.hideWaitOverlay();
+            this.toast('Could not download that example. Check your internet connection.', 'error');
+          });
+      },
+      cancelAction: () => {},
+      finalAction: () => {},
+    });
+  }
+
+  /**
+   * A small JPEG of frame 1 for project lists and Learn cards. Returns a data URL, or null if it fails.
+   * Renders frame 1 on the editor canvas with the whole project in view, copies the project area
+   * into a small canvas, then puts the editor back the way it was.
+   */
+  makeProjectThumbnail = (width) => {
+    let project = this.project;
+    let view = project.view;
