@@ -0,0 +1,231 @@
+/*
+ * The tool strip in the timeline's top row: play range, frame length, push/overwrite, in-between,
+ * duplicate, reverse and loops. Icon buttons keep it small. The ⋯ menu picks which tools show and
+ * whether their names show, saved on this device.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import React, { useState, useRef, useEffect } from 'react';
+import ReactDOM from 'react-dom';
+import './_timelinetools.scss';
+import { getOverride } from '../../../Icons/siteIcons';
+
+const ICONS = {
+  // |← with a little S, and →| with a little E
+  start: <><path d='M2.5 2v10' /><path d='M12 7H4.5' /><path d='M7.5 4L4.5 7l3 3' /><text x='12.2' y='15.6' fontSize='6.5' fontWeight='800' fill='currentColor' stroke='none' fontFamily='Nunito Sans, sans-serif'>S</text></>,
+  end: <><path d='M13.5 2v10' /><path d='M4 7h7.5' /><path d='M8.5 4l3 3-3 3' /><text x='0.6' y='15.6' fontSize='6.5' fontWeight='800' fill='currentColor' stroke='none' fontFamily='Nunito Sans, sans-serif'>E</text></>,
+  repeat: <><path d='M2.5 7.5a5 5 0 0 1 9-3' /><path d='M12 1.5v3.5H8.5' /><path d='M13.5 8.5a5 5 0 0 1-9 3' /><path d='M4 14.5V11h3.5' /></>,
+  once: <><path d='M2 8h8.5' /><path d='M8 5l3 3-3 3' /><path d='M14 3v10' /></>,
+  // the guide layer's dotted path
+  guide: <><path d='M2 12.7C4.7 4 10 2.7 13.3 6' strokeDasharray='2.1 2.1' /><circle cx='2.3' cy='12.7' r='1.6' fill='currentColor' stroke='none' /><path d='M11.3 3.7l3 2.6-3.6 1.3z' fill='currentColor' stroke='none' /></>,
+  minus: <path d='M3.5 8h9' />,
+  plus: <><path d='M3.5 8h9' /><path d='M8 3.5v9' /></>,
+  // a growing frame shoves the next one along
+  push: <><rect x='1' y='4' width='6.5' height='8' rx='1' fill='currentColor' fillOpacity='0.55' /><path d='M8.6 8h2.6' /><path d='M10.2 6.2L12 8l-1.8 1.8' /><rect x='12.8' y='4' width='2.4' height='8' rx='0.8' /></>,
+  // a growing frame covers the next one
+  overwrite: <><rect x='7' y='4' width='8' height='8' rx='1' strokeDasharray='1.6 1.6' /><rect x='1' y='4' width='10' height='8' rx='1' fill='currentColor' fillOpacity='0.55' /></>,
+  inbetween: <><rect x='1' y='4' width='4' height='8' rx='1' /><rect x='11' y='4' width='4' height='8' rx='1' /><circle cx='8' cy='8' r='1.8' fill='currentColor' stroke='none' /></>,
+  duplicate: <><rect x='1.5' y='1.5' width='8.5' height='8.5' rx='1.5' /><rect x='6' y='6' width='8.5' height='8.5' rx='1.5' /></>,
+  reverse: <><path d='M2 5h10.5' /><path d='M10 2.5L12.5 5 10 7.5' /><path d='M14 11H3.5' /><path d='M6 8.5L3.5 11 6 13.5' /></>,
+  loop: <><path d='M12.5 5.5a5 5 0 1 0 .8 4' /><path d='M13.5 2v3.5H10' /></>,
+  edit: <><path d='M2.5 13.5l.8-3.3 7.4-7.4 2.5 2.5-7.4 7.4z' /><path d='M9.3 4.2l2.5 2.5' /></>,
+  toEnd: <><path d='M10 5.5a4 4 0 1 0 .6 3.2' /><path d='M11 2.5v3H8' /><path d='M14.5 2.5v11' /></>,
+  // + with an empty frame on its right (before) or left (after)
+  blankBefore: <><path d='M4 5.2v5.6M1.2 8h5.6' /><rect x='8.8' y='3' width='6' height='10' rx='1.2' strokeDasharray='1.8 1.6' /></>,
+  blankAfter: <><rect x='1.2' y='3' width='6' height='10' rx='1.2' strokeDasharray='1.8 1.6' /><path d='M12 5.2v5.6M9.2 8h5.6' /></>,
+  more: <><circle cx='3' cy='8' r='1.3' fill='currentColor' stroke='none' /><circle cx='8' cy='8' r='1.3' fill='currentColor' stroke='none' /><circle cx='13' cy='8' r='1.3' fill='currentColor' stroke='none' /></>,
+};
+
+/** Names for the strip icons, for the developer's icon list. */
+export const STRIP_ICONS = {
+  start: 'Loop start', end: 'Loop end', repeat: 'Loop on', once: 'Loop off', minus: 'Exposure −1', plus: 'Exposure +1',
+  blankBefore: 'Add blank frame before', blankAfter: 'Add blank frame after', duplicate: 'Duplicate', reverse: 'Reverse frames',
+  loop: 'Loop selected frames / +1 loop', edit: 'Edit loop', toEnd: 'Loop to end', more: 'Choose tools (⋯)',
+};
+
+export function Icon ({ name, size }) {
+  let custom = getOverride('strip:' + name);
+  if (custom) return <img className='tt-svg tt-img' src={custom} width={size || 16} height={size || 16} alt='' draggable='false' />;
+  return (
+    <svg className='tt-svg' viewBox='0 0 16 16' width={size || 16} height={size || 16} fill='none' xmlns='http://www.w3.org/2000/svg' stroke='currentColor'
+      strokeWidth='1.8' strokeLinecap='round' strokeLinejoin='round' aria-hidden='true'>{ICONS[name]}</svg>
+  );
+}
+
+/** Tools in the strip. The ⋯ menu shows, hides and reorders them. */
+const TOOLS = [
+  { id: 'range', name: 'Loop start and end', icon: 'start' },
+  { id: 'repeat', name: 'Loop on / off', icon: 'repeat' },
+  { id: 'length', name: 'Exposure −1 / +1', icon: 'plus' },
+  { id: 'blank', name: 'Add blank frame before / after', icon: 'blankAfter' },
+  { id: 'duplicate', name: 'Duplicate', icon: 'duplicate' },
+  { id: 'reverse', name: 'Reverse frames', icon: 'reverse' },
+  { id: 'loop', name: 'Loop selected frames', icon: 'loop' },
+];
+const DEFAULT_ORDER = TOOLS.map(t => t.id);
+
+function loadPrefs () {
+  try {
+    let p = JSON.parse(window.localStorage.getItem('stripTools') || '{}');
+    let order = (Array.isArray(p.order) ? p.order : []).filter(id => DEFAULT_ORDER.indexOf(id) !== -1);
+    // New tools go where they belong by default (right after the tool before them), not at the end.
+    DEFAULT_ORDER.forEach((id, n) => {
+      if (order.indexOf(id) !== -1) return;
+      let prev = n > 0 ? order.indexOf(DEFAULT_ORDER[n - 1]) : -1;
+      order.splice(prev + 1, 0, id);
+    });
+    return { hidden: Array.isArray(p.hidden) ? p.hidden : [], names: !!p.names, order: order };
+  } catch (e) { return { hidden: [], names: false, order: DEFAULT_ORDER.slice() }; }
+}
+
+function savePrefs (prefs) {
+  try { window.localStorage.setItem('stripTools', JSON.stringify(prefs)); } catch (e) {}
+}
+
+/** A number box for one end of the play range. Typing a number and pressing return (or tapping away) sets it. */
+function RangeBox ({ value, placeholder, label, onSet }) {
+  let [text, setText] = useState(null); // null = not editing, show the saved value
+  let commit = () => { if (text !== null && text.trim() !== '') onSet(text); setText(null); };
+  return (
+    <input className='tt-range-box' type='text' inputMode='numeric' pattern='[0-9]*' maxLength={4} aria-label={label} title={label}
+      value={text !== null ? text : (value || '')} placeholder={placeholder}
+      onFocus={e => { setText(String(value || '')); setTimeout(() => e.target.select && e.target.select(), 0); }}
+      onChange={e => setText(e.target.value.replace(/[^0-9]/g, ''))}
+      onBlur={commit}
+      onKeyDown={e => { if (e.key === 'Enter') e.target.blur(); if (e.key === 'Escape') { setText(null); e.target.blur(); } }} />
+  );
+}
+
+export default function TimelineTools (props) {
+  let editor = props.editor;
+  let [prefs, setPrefs] = useState(loadPrefs);
+  let [menu, setMenu] = useState(null); // {x, y} when the ⋯ menu is open
+  let moreRef = useRef(null);
+  useEffect(() => {
+    if (!menu) return;
+    let close = (e) => { if (!e.target.closest || !e.target.closest('.tt-menu, .tt-more')) setMenu(null); };
+    window.addEventListener('pointerdown', close, true);
+    return () => window.removeEventListener('pointerdown', close, true);
+  }, [menu]);
+  if (!editor || !editor.changeFrameLength) return null;
+
+  let loopFrame = editor.getSelectedLoopFrame();
+  let loopEdit = editor.getLoopEdit();
+  let editing = loopEdit ? { identifier: loopEdit.identifier } : editor.getFocusedLoop();
+  editor.syncPlayRangeToTimeline();
+  let range = editor.getPlayRange();
+  let repeat = editor.getPlayRepeat();
+  let stop = e => e.stopPropagation();
+  let shown = (id) => prefs.hidden.indexOf(id) === -1;
+  let update = (next) => { setPrefs(next); savePrefs(next); };
+
+  // One button. "label" is the name shown with names on, and what screen readers say.
+  let B = ({ icon, label, title, onClick, on, cls, text }) => (
+    <button className={'tt-btn' + (on ? ' tt-on' : '') + (cls ? ' ' + cls : '') + (prefs.names || text ? ' tt-named' : '')}
+      title={title || label} aria-label={label} aria-pressed={on === undefined ? undefined : !!on} onClick={onClick}>
+      {icon && <Icon name={icon} />}
+      {(prefs.names || text) && <span className='tt-name'>{text || label}</span>}
+    </button>
+  );
+
+  let tl = editor.project.root.timeline;
+  let renderTool = (id) => {
+    if (id === 'range') return (
+      <div className='tt-group' role='group' aria-label='Play range'>
+        <B icon='start' label='Loop start' title='Loop start: playing starts at the playhead (or type a frame number)' onClick={editor.setPlayRangeStart} />
+        <RangeBox value={range && range.start} placeholder='1' label='Loop start frame' onSet={v => editor.setPlayRangeValues(v, range ? range.end : null)} />
+        <RangeBox value={range && range.end} placeholder={String(Math.max(1, tl.length))} label='Loop end frame' onSet={v => editor.setPlayRangeValues(range ? range.start : null, v)} />
+        <B icon='end' label='Loop end' title='Loop end: playing ends at the playhead (or type a frame number)' onClick={editor.setPlayRangeEnd} />
+        {range && <button className='tt-btn tt-clear' aria-label={'Clear loop start and end (' + range.start + ' to ' + range.end + ')'}
+          title='Clear loop start and end: play the whole animation again' onClick={editor.clearPlayRange}>✕</button>}
+      </div>);
+    if (id === 'repeat') return (
+      <div className='tt-group'>
+        <B icon={repeat ? 'repeat' : 'once'} on={repeat} label={repeat ? 'Loop on' : 'Loop off'}
+          title={repeat ? 'Loop on: playing starts over at the end. Tap to play once.' : 'Loop off: playing stops at the end. Tap to loop.'}
+          onClick={editor.togglePlayRepeat} />
+      </div>);
+    if (id === 'length') return (
+      <div className='tt-group' role='group' aria-label='Frame length'>
+        <B icon='minus' label='Exposure −1' title='Exposure −1: this drawing lasts one frame less' onClick={() => editor.changeFrameLength(-1)} />
+        <B icon='plus' label='Exposure +1' title='Exposure +1: this drawing lasts one frame more' onClick={() => editor.changeFrameLength(1)} />
+      </div>);
+    if (id === 'blank') return (
+      <div className='tt-group' role='group' aria-label='Blank frames'>
+        <B icon='blankBefore' label='Add blank frame before' title='Add a blank frame before this one (the rest move along)' onClick={() => editor.addBlankFrame('before')} />
+        <B icon='blankAfter' label='Add blank frame after' title='Add a blank frame after this one (the rest move along)' onClick={() => editor.addBlankFrame('after')} />
+      </div>);
+    if (id === 'duplicate') return (
+      <div className='tt-group'><B icon='duplicate' label='Duplicate' title='Copy the selected frames and put the copy right after them' onClick={editor.duplicateFrames} /></div>);
+    if (id === 'reverse') return (
+      <div className='tt-group'><B icon='reverse' label='Reverse frames' title='Reverse frames: play the selected frames backwards' onClick={editor.reverseFrames} /></div>);
+    if (id === 'loop' && !editing) return (
+      <div className='tt-group' role='group' aria-label='Loop'>
+        {loopFrame ? <>
+          <B icon='edit' cls='tt-loop' label='Edit loop' title='Open the loop right here to change its drawings' onClick={() => editor.editSelectedLoop()} />
+          <B icon='loop' cls='tt-loop' label='+1 loop' text={prefs.names ? null : '+1'} title='Play the loop one more time' onClick={editor.repeatSelectedLoop} />
+          <B icon='toEnd' cls='tt-loop' label='Loop to end' title='Keep looping until the end of the animation' onClick={editor.loopSelectedToEnd} />
+        </> : <B icon='loop' cls='tt-loop' label='Loop selected frames' title='Loop selected frames: put them in a loop that repeats' onClick={editor.makeLoopFromSelectedFrames} />}
+      </div>);
+    return null;
+  };
+
+  let move = (id, dir) => {
+    let order = prefs.order.slice();
+    let i = order.indexOf(id), j = i + dir;
+    if (j < 0 || j >= order.length) return;
+    order[i] = order[j]; order[j] = id;
+    update(Object.assign({}, prefs, { order: order }));
+  };
+
+  let openMenu = () => {
+    if (menu) { setMenu(null); return; }
+    let r = moreRef.current.getBoundingClientRect();
+    setMenu({ right: Math.max(8, window.innerWidth - r.right), bottom: Math.max(8, window.innerHeight - r.top + 6) });
+  };
+
+  return (
+    <div className='timeline-tools' onPointerDown={stop} onMouseDown={stop} onTouchStart={stop}>
+      {editing &&
+        <div className='tt-group tt-editing-group' role='group' aria-label='Editing loop'>
+          <span className='tt-editing'>Editing {editing.identifier || 'loop'}</span>
+          <B cls='tt-done' label='Done' text='Done' title='Put the loop back together' onClick={() => editor.finishEditingLoop()} />
+        </div>}
+
+      {prefs.order.filter(shown).map(id => <React.Fragment key={id}>{renderTool(id)}</React.Fragment>)}
+
+      <span ref={moreRef} className='tt-group'>
+        <button className={'tt-btn tt-more' + (menu ? ' tt-on' : '')} aria-label='Choose tools' title='Choose which tools show' aria-expanded={!!menu} onClick={openMenu}>
+          <Icon name='more' />
+        </button>
+      </span>
+
+      {menu && ReactDOM.createPortal(
+        <div className='tt-menu' style={{ right: menu.right, bottom: menu.bottom }} onPointerDown={stop} role='dialog' aria-label='Timeline tools'>
+          <div className='tt-menu-title'>Timeline tools</div>
+          <label className='tt-menu-row tt-menu-names'>
+            <input type='checkbox' checked={prefs.names} onChange={e => update(Object.assign({}, prefs, { names: e.target.checked }))} />
+            <span>Show names on the buttons</span>
+          </label>
+          <div className='tt-menu-sub'>Show and arrange the tools</div>
+          {prefs.order.map((id, n) => {
+            let t = TOOLS.find(x => x.id === id);
+            return (
+              <div key={id} className='tt-menu-row'>
+                <label className='tt-menu-check'>
+                  <input type='checkbox' checked={shown(id)}
+                    onChange={e => update(Object.assign({}, prefs, { hidden: e.target.checked ? prefs.hidden.filter(h => h !== id) : prefs.hidden.concat([id]) }))} />
+                  <span className='tt-menu-icon'><Icon name={t.icon} /></span>
+                  <span>{t.name}</span>
+                </label>
+                <button className='tt-menu-move' aria-label={'Move ' + t.name + ' left'} title='Move left' disabled={n === 0} onClick={() => move(id, -1)}>‹</button>
+                <button className='tt-menu-move' aria-label={'Move ' + t.name + ' right'} title='Move right' disabled={n === prefs.order.length - 1} onClick={() => move(id, 1)}>›</button>
+              </div>);
+          })}
+          <button className='tt-menu-reset' onClick={() => update({ hidden: [], names: false, order: DEFAULT_ORDER.slice() })}>Reset to default</button>
+        </div>, document.body)}
+    </div>
+  );
+}
