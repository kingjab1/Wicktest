new file mode 100644
index 0000000..d64c90d
--- /dev/null
+++ b/src/Editor/Gestures/canvasGestures.js
@@ -0,0 +1,423 @@
+/*
+ * Touch gestures for the canvas (iPad):
+ *   - two fingers: pinch to zoom, drag to pan, twist to rotate (snaps back to straight near 0°)
+ *   - two-finger tap: undo, three-finger tap: redo
+ *   - snap to shape: draw a line, circle, triangle or rectangle with the brush or pencil, then hold
+ *     your finger still for a moment before lifting. The wobbly stroke turns into a clean shape.
+ *
+ * A single finger is held back for a split second so a second finger can join without leaving a mark.
+ * Apple Pencil strokes go straight through.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+const HOLD_BACK_MS = 70;      // how long one finger waits to see if a second one is coming
+const TAP_MAX_MS = 300;       // a quick two- or three-finger touch counts as a tap
+const TAP_MAX_MOVE = 14;      // px
+const SNAP_HOLD_MS = 550;     // hold still this long at the end of a stroke to snap it
+const SNAP_STILL_PX = 6;
+const ROTATE_START_DEG = 12;  // twist this far before the canvas starts turning
+const ROTATE_SNAP_DEG = 7;    // ends up straight if it's this close to 0°
+
+export default function installCanvasGestures (editor) {
+  if (window.__keyflameGestures) return;
+  window.__keyflameGestures = true;
+
+  let state = 'idle'; // idle | pending | drawing | gesture | snapped
+  let buffer = [];
+  let timer = null;
+  let replaying = new WeakSet();
+  let canReplay = true;
+  let g = null;       // gesture info
+  let stroke = null;  // points of the current stroke, for snap to shape
+  let snapTimer = null;
+
+  const project = () => editor.project;
+  const paperView = () => project() && project().view && project().view.paper && project().view.paper.view;
+  const container = () => project() && project().view && project().view.canvasContainer;
+  const inCanvas = (target) => {
+    let c = container();
+    return !!(c && target && target.nodeType === 1 && c.contains(target) && target.tagName === 'CANVAS');
+  };
+  const isStylus = (t) => t && t.touchType === 'stylus';
+  const block = (e) => { e.stopImmediatePropagation(); if (e.cancelable) e.preventDefault(); };
+  const playing = () => editor.state && editor.state.previewPlaying;
+
+  /* ----- holding back one finger ----- */
+
+  function flush () {
+    clearTimeout(timer);
+    timer = null;
+    let events = buffer;
+    buffer = [];
+    state = 'drawing';
+    for (let ev of events) {
+      try {
+        replaying.add(ev);
+        ev.target.dispatchEvent(ev);
+      } catch (err) {
+        // This browser won't re-send touches; stop holding them back from now on.
+        canReplay = false;
+        console.warn('Touch replay not supported', err);
+        break;
+      }
+    }
+  }
+
+  /* ----- two-finger view changes ----- */
+
+  function fingers (touches) {
+    let list = Array.from(touches).slice(0, 2);
+    let pv = paperView();
+    let rect = pv.element.getBoundingClientRect();
+    let a = { x: list[0].clientX - rect.left, y: list[0].clientY - rect.top };
+    let b = list[1] ? { x: list[1].clientX - rect.left, y: list[1].clientY - rect.top } : a;
+    return {
+      cx: (a.x + b.x) / 2, cy: (a.y + b.y) / 2,
+      dist: Math.max(1, Math.hypot(b.x - a.x, b.y - a.y)),
+      angle: Math.atan2(b.y - a.y, b.x - a.x) * 180 / Math.PI,
+    };
+  }
+
+  function startGesture (e) {
+    let pv = paperView();
+    let f = fingers(e.touches);
+    g = {
+      time: Date.now(), maxTouches: e.touches.length, moved: false, rotating: false,
+      start: f, zoom: pv.zoom, rotation: project().rotation || 0,
+      anchor: pv.viewToProject(new window.paper.Point(f.cx, f.cy)),
+      frame: null,
+    };
+  }
+
+  function moveGesture (e) {
+    if (e.touches.length < 2) return;
+    g.maxTouches = Math.max(g.maxTouches, e.touches.length);
+    let f = fingers(e.touches);
+    let s = g.start;
+    let twist = ((f.angle - s.angle + 540) % 360) - 180;
+    if (!g.moved && (Math.abs(f.dist - s.dist) > TAP_MAX_MOVE || Math.hypot(f.cx - s.cx, f.cy - s.cy) > TAP_MAX_MOVE)) g.moved = true;
+    if (!g.rotating && Math.abs(twist) > ROTATE_START_DEG) { g.rotating = true; g.moved = true; g.twistOffset = twist; }
+    if (!g.moved || g.maxTouches > 2) return;
+    g.next = { f: f, twist: g.rotating ? twist : 0 };
+    if (!g.frame) g.frame = window.requestAnimationFrame(applyGesture);
+  }
+
+  function applyGesture () {
+    g.frame = null;
+    if (!g || !g.next) return;
+    let pv = paperView();
+    let { f, twist } = g.next;
+    let view = project().view;
+    let zoom = Math.min(10, Math.max(0.1, g.zoom * f.dist / g.start.dist));
+    let rotation = g.rotation + twist;
+    project().rotation = rotation;
+    pv.rotation = rotation;
+    pv.zoom = zoom;
+    let here = pv.viewToProject(new window.paper.Point(f.cx, f.cy));
+    pv.center = pv.center.add(g.anchor.subtract(here));
+    view._applyZoomAndPanChangesFromPaper();
+  }
+
+  function endGesture () {
+    if (g.frame) { window.cancelAnimationFrame(g.frame); g.frame = null; }
+    let quick = Date.now() - g.time < TAP_MAX_MS;
+    if (!g.moved && quick) {
+      if (g.maxTouches >= 3) editor.redoAction();
+      else editor.undoAction();
+    } else if (g.moved) {
+      // Close to straight? Make it straight.
+      let r = ((project().rotation % 360) + 360) % 360;
+      if (r > 180) r -= 360;
+      if (Math.abs(r) < ROTATE_SNAP_DEG && r !== 0) {
+        let pv = paperView();
+        let c = pv.center;
+        project().rotation = 0;
+        pv.rotation = 0;
+        pv.center = c;
+        project().view._applyZoomAndPanChangesFromPaper();
+      }
+      editor.projectDidChange({ skipHistory: true, actionName: 'Move Canvas' });
+    }
+    g = null;
+  }
+
+  /** A stroke was already drawing when a second finger came down: throw that stroke away. */
+  function cancelStroke () {
+    let tool = project().activeTool;
+    try {
+      if (tool && typeof tool.discard === 'function') tool.discard();
+      if (tool && tool.path && tool.path.remove) { tool.path.remove(); tool.path = null; }
+      if (tool && typeof tool.reset === 'function' && tool !== project().tools.brush) tool.reset();
+    } catch (err) { console.warn(err); }
+    project().view.render();
+  }
+
+  /**
+   * Let a finger's release reach the drawing code without doing anything, so it knows the touch is over.
+   * (The stroke was already thrown away or turned into a shape.)
+   */
+  function releaseQuietly () {
+    let p = project();
+    let tool = p.activeTool;
+    let none = p.tools && p.tools.none;
+    if (!none || !none.paperTool || !tool || !tool.paperTool) return;
+    none.paperTool.activate();
+    setTimeout(() => { if (p.activeTool === tool) tool.paperTool.activate(); }, 0);
+  }
+
+  /* ----- snap to shape ----- */
+
+  function snapTool () {
+    let p = project();
+    let tool = p.activeTool;
+    if (tool === p.tools.brush || tool === p.tools.pencil) return tool;
+    return null;
+  }
+
+  function strokePoint (touch) {
+    let pv = paperView();
+    let rect = pv.element.getBoundingClientRect();
+    return { screen: { x: touch.clientX, y: touch.clientY }, at: pv.viewToProject(new window.paper.Point(touch.clientX - rect.left, touch.clientY - rect.top)) };
+  }
+
+  function armSnap () {
+    clearTimeout(snapTimer);
+    snapTimer = setTimeout(trySnap, SNAP_HOLD_MS);
+  }
+
+  function trySnap () {
+    if (state !== 'drawing' || !stroke || !snapTool()) return;
+    let shape = recognize(stroke.points.map(p => p.at));
+    if (!shape) return;
+    let p = project();
+    let tool = snapTool();
+    let paper = window.paper;
+    let width, color;
+    if (tool === p.tools.brush) {
+      let size = tool.getSetting('brushSize') + 1;
+      width = tool.getSetting('relativeBrushSize') ? size / paperView().zoom : size;
+      color = tool.getSetting('fillColor').rgba;
+    } else {
+      width = tool.getSetting('strokeWidth');
+      color = tool.getSetting('strokeColor').rgba;
+    }
+    cancelStroke();
+    let path;
+    if (shape.type === 'line') {
+      path = new paper.Path.Line({ from: shape.from, to: shape.to, insert: false });
+    } else if (shape.type === 'ellipse') {
+      path = new paper.Path.Ellipse({ center: shape.center, radius: shape.radius, insert: false });
+      if (shape.rotation) path.rotate(shape.rotation, shape.center);
+    } else {
+      path = new paper.Path({ segments: shape.points, closed: true, insert: false });
+    }
+    path.strokeColor = color;
+    path.strokeWidth = width;
+    path.strokeCap = 'round';
+    path.strokeJoin = 'round';
+    path.fillColor = null;
+    tool.addPathToProject(path);
+    tool.fireEvent({ eventName: 'canvasModified', actionName: 'snapToShape' });
+    state = 'snapped'; // ignore the rest of this touch
+    stroke = null;
+  }
+
+  /* ----- touch handlers (capture phase, before the drawing tools see anything) ----- */
+
+  function onStart (e) {
+    if (replaying.has(e)) { replaying.delete(e); return; }
+    if (!inCanvas(e.target) || playing()) return;
+    let touches = e.touches;
+    let stylus = Array.from(touches).some(isStylus);
+
+    if (state === 'idle' || (state === 'snapped' && touches.length === 1)) {
+      if (touches.length === 1) {
+        stroke = { points: [strokePoint(touches[0])], last: Date.now() };
+        if (stylus || !canReplay) { state = 'drawing'; armSnap(); return; }
+        state = 'pending';
+        buffer = [e];
+        timer = setTimeout(() => { flush(); armSnap(); }, HOLD_BACK_MS);
+        block(e);
+        return;
+      }
+      state = 'gesture';
+      startGesture(e);
+      block(e);
+      return;
+    }
+    if (state === 'pending') {
+      clearTimeout(timer);
+      buffer = [];
+      state = 'gesture';
+      startGesture(e);
+      block(e);
+      return;
+    }
+    if (state === 'drawing') {
+      if (stylus) return; // a palm next to the Pencil: leave the stroke alone
+      clearTimeout(snapTimer);
+      cancelStroke();
+      state = 'gesture';
+      startGesture(e);
+      g.fromDrawing = true;
+      block(e);
+      return;
+    }
+    if (state === 'gesture' || state === 'snapped') {
+      if (state === 'gesture') g.maxTouches = Math.max(g.maxTouches, touches.length);
+      block(e);
+    }
+  }
+
+  function onMove (e) {
+    if (replaying.has(e)) { replaying.delete(e); return; }
+    if (state === 'pending') {
+      let t = e.touches[0];
+      if (t && stroke) {
+        stroke.points.push(strokePoint(t));
+        let s = stroke.points[0].screen;
+        if (Math.hypot(t.clientX - s.x, t.clientY - s.y) > 24) {
+          // Clearly drawing: send what was held back, then let this touch through as usual.
+          flush();
+          armSnap();
+          return;
+        }
+      }
+      buffer.push(e);
+      block(e);
+      return;
+    }
+    if (state === 'gesture') { moveGesture(e); block(e); return; }
+    if (state === 'snapped') { block(e); return; }
+    if (state === 'drawing' && stroke && e.touches[0]) {
+      let pt = strokePoint(e.touches[0]);
+      stroke.points.push(pt);
+      // Restart the hold timer whenever the finger wanders away from where it last rested.
+      let rest = stroke.rest || stroke.points[0].screen;
+      if (Math.hypot(pt.screen.x - rest.x, pt.screen.y - rest.y) > SNAP_STILL_PX) { stroke.rest = pt.screen; armSnap(); }
+    }
+  }
+
+  function onEnd (e) {
+    if (replaying.has(e)) { replaying.delete(e); return; }
+    if (state === 'pending') {
+      // A quick one-finger tap: send it on now.
+      flush();
+      if (!canReplay) return;
+      state = e.touches.length ? 'drawing' : 'idle';
+      stroke = null;
+      return; // this touchend goes through normally
+    }
+    if (state === 'gesture') {
+      if (e.touches.length === 0) {
+        let fromDrawing = g.fromDrawing;
+        endGesture();
+        state = 'idle';
+        if (fromDrawing) { releaseQuietly(); return; }
+      }
+      block(e);
+      return;
+    }
+    if (state === 'snapped') {
+      if (e.touches.length === 0) { state = 'idle'; releaseQuietly(); return; }
+      block(e);
+      return;
+    }
+    if (state === 'drawing' && e.touches.length === 0) {
+      clearTimeout(snapTimer);
+      stroke = null;
+      state = 'idle';
+    }
+  }
+
+  let opts = { capture: true, passive: false };
+  window.addEventListener('touchstart', onStart, opts);
+  window.addEventListener('touchmove', onMove, opts);
+  window.addEventListener('touchend', onEnd, opts);
+  window.addEventListener('touchcancel', onEnd, opts);
+}
+
+/* ---------- shape recognition ---------- */
+
+function dist (a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }
+
+function distToSegment (p, a, b) {
+  let l2 = (b.x - a.x) ** 2 + (b.y - a.y) ** 2;
+  if (!l2) return dist(p, a);
+  let t = Math.max(0, Math.min(1, ((p.x - a.x) * (b.x - a.x) + (p.y - a.y) * (b.y - a.y)) / l2));
+  return dist(p, { x: a.x + t * (b.x - a.x), y: a.y + t * (b.y - a.y) });
+}
+
+function simplify (pts, eps) {
+  if (pts.length < 3) return pts.slice();
+  let maxD = 0, idx = 0;
+  for (let i = 1; i < pts.length - 1; i++) {
+    let d = distToSegment(pts[i], pts[0], pts[pts.length - 1]);
+    if (d > maxD) { maxD = d; idx = i; }
+  }
+  if (maxD <= eps) return [pts[0], pts[pts.length - 1]];
+  let left = simplify(pts.slice(0, idx + 1), eps);
+  let right = simplify(pts.slice(idx), eps);
+  return left.slice(0, -1).concat(right);
+}
+
+/** Guess what shape a wobbly stroke was meant to be. Returns null if it doesn't look like one. */
+export function recognize (raw) {
+  let pts = raw.map(p => ({ x: p.x, y: p.y }));
+  // drop points that barely moved
+  pts = pts.filter((p, i) => i === 0 || dist(p, pts[i - 1]) > 0.5);
+  if (pts.length < 4) return null;
+  let xs = pts.map(p => p.x), ys = pts.map(p => p.y);
+  let minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
+  let minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
+  let size = Math.max(maxX - minX, maxY - minY);
+  if (size < 12) return null;
+  let first = pts[0], last = pts[pts.length - 1];
+  let length = 0;
+  for (let i = 1; i < pts.length; i++) length += dist(pts[i], pts[i - 1]);
+
+  // A line: every point stays close to the line from start to end.
+  let span = dist(first, last);
+  if (span > size * 0.8 && pts.every(p => distToSegment(p, first, last) < Math.max(4, span * 0.07))) {
+    return { type: 'line', from: first, to: last };
+  }
+
+  // Closed shapes: the stroke comes back near where it started.
+  let closed = span < size * 0.3 || span < length * 0.12;
+  if (!closed) return null;
+
+  let corners = simplify(pts.concat([first]), size * 0.12);
+  // Drop the repeated start point at the end, and merge corners that sit too close together.
+  if (corners.length > 1 && dist(corners[0], corners[corners.length - 1]) < size * 0.2) corners.pop();
+  corners = corners.filter((c, i) => i === 0 || dist(c, corners[i - 1]) > size * 0.15);
+
+  let cx = (minX + maxX) / 2, cy = (minY + maxY) / 2;
+  let rx = (maxX - minX) / 2, ry = (maxY - minY) / 2;
+  // How round is it? Average distance from a perfect ellipse in the same box.
+  let ellipseErr = pts.reduce((sum, p) => {
+    let nx = (p.x - cx) / Math.max(rx, 1), ny = (p.y - cy) / Math.max(ry, 1);
+    return sum + Math.abs(Math.hypot(nx, ny) - 1);
+  }, 0) / pts.length;
+
+  if (corners.length === 3 && ellipseErr > 0.08) return { type: 'polygon', points: corners };
+  if (corners.length === 4 && ellipseErr > 0.08) {
+    // Nearly square to the page? Make it a neat rectangle.
+    let edgesStraight = corners.every((c, i) => {
+      let n = corners[(i + 1) % 4];
+      let ang = Math.abs(Math.atan2(n.y - c.y, n.x - c.x) * 180 / Math.PI) % 90;
+      return ang < 12 || ang > 78;
+    });
+    if (edgesStraight) {
+      return { type: 'polygon', points: [{ x: minX, y: minY }, { x: maxX, y: minY }, { x: maxX, y: maxY }, { x: minX, y: maxY }] };
+    }
+    return { type: 'polygon', points: corners };
+  }
+  if (ellipseErr < 0.22) {
+    // Close to a circle? Make it a perfect circle.
+    if (Math.abs(rx - ry) < Math.max(rx, ry) * 0.15) { let r = (rx + ry) / 2; rx = r; ry = r; }
+    return { type: 'ellipse', center: { x: cx, y: cy }, radius: [rx, ry] };
+  }
+  return null;
+}
