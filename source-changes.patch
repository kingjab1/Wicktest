index 0000000..058ce7d
--- /dev/null
+++ b/src/Editor/Panels/Timeline/TimelineTools/TimelineTools.jsx
@@ -0,0 +1,70 @@
+/*
+ * Buttons in the timeline's top row: make a drawing one frame longer or shorter,
+ * choose whether that pushes or overwrites the frames next to it, and turn
+ * frames into a loop.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import React from 'react';
+import './_timelinetools.scss';
+
+export default function TimelineTools (props) {
+  let editor = props.editor;
+  if (!editor || !editor.changeFrameLength) return null;
+  let mode = editor.getFrameLengthMode();
+  let loopFrame = editor.getSelectedLoopFrame();
+  let focusedLoop = editor.getFocusedLoop();
+  editor.syncPlayRangeToTimeline();
+  let range = editor.getPlayRange();
+  let repeat = editor.getPlayRepeat();
+  let guides = editor.getGuidesWhilePlaying();
+  let stop = e => e.stopPropagation();
+  return (
+    <div className='timeline-tools' onPointerDown={stop} onMouseDown={stop} onTouchStart={stop}>
+      <div className='timeline-tools-group' role='group' aria-label='Play range'>
+        <button className='tt-btn tt-range' title='Playing starts at the playhead' onClick={editor.setPlayRangeStart}>⇤ Start</button>
+        <button className='tt-btn tt-range' title='Playing ends at the playhead' onClick={editor.setPlayRangeEnd}>End ⇥</button>
+        {range &&
+          <button className='tt-btn tt-chip' title='Play the whole animation again' aria-label={'Clear the play range ' + range.start + ' to ' + range.end} onClick={editor.clearPlayRange}>
+            {range.start}–{range.end} ✕
+          </button>}
+        <button className={'tt-btn' + (repeat ? ' tt-on' : '')} aria-pressed={repeat}
+          title={repeat ? 'Playing starts over at the end. Tap to play once.' : 'Playing stops at the end. Tap to repeat.'} onClick={editor.togglePlayRepeat}>
+          {repeat ? '⟲ Repeat' : '→ Once'}
+        </button>
+        <button className={'tt-btn' + (guides ? ' tt-on' : '')} aria-pressed={guides}
+          title={guides ? 'Guide layers show when you press play. Tap to hide them. Exports always leave them out.' : 'Guide layers are hidden when you press play. Tap to show them.'}
+          onClick={editor.toggleGuidesWhilePlaying}>
+          {guides ? 'Guides: show' : 'Guides: hide'}
+        </button>
+      </div>
+      <div className='timeline-tools-group' role='group' aria-label='Frame length'>
+        <button className='tt-btn tt-icon' title='One frame shorter' aria-label='One frame shorter' onClick={() => editor.changeFrameLength(-1)}>−</button>
+        <span className='tt-label'>Length</span>
+        <button className='tt-btn tt-icon' title='One frame longer' aria-label='One frame longer' onClick={() => editor.changeFrameLength(1)}>+</button>
+      </div>
+      <div className='timeline-tools-group tt-seg' role='group' aria-label='When a frame changes length'>
+        <button className={'tt-btn' + (mode === 'push' ? ' tt-on' : '')} aria-pressed={mode === 'push'}
+          title='Longer frames push the next frames along. Shorter frames pull them back.' onClick={() => editor.setFrameLengthMode('push')}>Push</button>
+        <button className={'tt-btn' + (mode === 'overwrite' ? ' tt-on' : '')} aria-pressed={mode === 'overwrite'}
+          title='Longer frames cover the next frames. Shorter frames leave a gap.' onClick={() => editor.setFrameLengthMode('overwrite')}>Overwrite</button>
+      </div>
+      {focusedLoop &&
+        <div className='timeline-tools-group' role='group' aria-label='Editing loop'>
+          <span className='tt-editing'>Editing {focusedLoop.identifier || 'loop'}</span>
+          <button className='tt-btn tt-done' title='Go back to the main timeline' onClick={editor.finishEditingLoop}>Done</button>
+        </div>}
+      {loopFrame
+        ? <div className='timeline-tools-group' role='group' aria-label='Loop'>
+            <button className='tt-btn tt-loop' title='Go inside the loop to change its drawings' onClick={editor.editSelectedLoop}>Edit loop</button>
+            <button className='tt-btn tt-loop' title='Play the loop one more time' onClick={editor.repeatSelectedLoop}>⟳ +1 loop</button>
+            <button className='tt-btn tt-loop' title='Keep looping until the end of the animation' onClick={editor.loopSelectedToEnd}>Loop to end</button>
+          </div>
+        : !focusedLoop && <div className='timeline-tools-group'>
+            <button className='tt-btn tt-loop' title='Put the selected frames in a loop' onClick={editor.makeLoopFromSelectedFrames}>⟳ Loop frames</button>
+          </div>}
+    </div>
+  );
+}
