+/*
+ * Shows a button's name when an Apple Pencil hovers over it (Safari doesn't show title tooltips for the
+ * Pencil). A mouse already gets the browser's own tooltip, so this only runs for the Pencil.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+export default function installHoverLabels () {
+  if (window.__keyflameHoverLabels) return;
+  window.__keyflameHoverLabels = true;
+
+  let bubble = null, timer = null, current = null;
+
+  function hide () {
+    clearTimeout(timer);
+    timer = null;
+    current = null;
+    if (bubble) bubble.style.display = 'none';
+  }
+
+  function show (el) {
+    let text = el.getAttribute('data-label') || el.getAttribute('aria-label') || el.getAttribute('title');
+    if (!text) return;
+    if (!bubble) {
+      bubble = document.createElement('div');
+      bubble.className = 'hover-label';
+      bubble.setAttribute('role', 'tooltip');
+      document.body.appendChild(bubble);
+    }
+    bubble.textContent = text;
+    bubble.style.display = 'block';
+    let r = el.getBoundingClientRect();
+    let b = bubble.getBoundingClientRect();
+    let x = Math.min(window.innerWidth - b.width - 6, Math.max(6, r.left + r.width / 2 - b.width / 2));
+    let y = r.top - b.height - 8;
+    if (y < 4) y = r.bottom + 8;
+    bubble.style.left = x + 'px';
+    bubble.style.top = y + 'px';
+  }
+
+  window.addEventListener('pointermove', (e) => {
+    if (e.pointerType !== 'pen' || e.buttons) { if (e.buttons) hide(); return; }
+    let el = e.target && e.target.closest && e.target.closest('[title], [aria-label], [data-label]');
+    if (el && (el.tagName === 'CANVAS' || el.id === 'root')) el = null;
+    if (el === current) return;
+    hide();
+    if (!el) return;
+    current = el;
+    timer = setTimeout(() => show(el), 280);
+  }, true);
+  ['pointerdown', 'pointerleave', 'pointercancel', 'scroll'].forEach(type => window.addEventListener(type, hide, true));
+}
