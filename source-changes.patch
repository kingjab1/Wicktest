+@import 'Editor/_wickbrand.scss';
+
+.learn-modal-body {
+  width: 860px;
+  height: 600px;
+  max-width: 94vw;
+  max-height: 88vh;
+  padding: 0px;
+}
+
+.learn {
+  width: 100%;
+  height: 100%;
+  padding: 18px 20px 10px 20px;
+  display: flex;
+  flex-direction: column;
+  color: $editor-modal-text-gray;
+  text-align: left;
+}
+
+.learn-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 12px;
+  padding-right: 36px; // room for the modal close button
+}
+
+.learn-title {
+  font-size: 20px;
+  font-weight: bold;
+  color: $editor-modal-text-white;
+}
+
+.learn-tabs {
+  display: flex;
+  background: $editor-modal-dark;
+  border-radius: 8px;
+  padding: 3px;
+}
+
+.learn-tab {
+  border: none;
+  background: transparent;
+  color: $editor-modal-text-dark;
+  font-size: 15px;
+  font-weight: bold;
+  padding: 7px 16px;
+  border-radius: 6px;
+  cursor: pointer;
+}
+
+.learn-tab-active {
+  background: $editor-green-highlight;
+  color: $editor-primary;
+}
+
+.learn-scroll {
+  flex: 1;
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+  padding-right: 4px;
+}
+
+.learn-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  grid-gap: 14px;
+  padding-bottom: 10px;
+}
+
+.learn-card {
+  background: $editor-modal-dark;
+  border-radius: 8px;
+  overflow: hidden;
+  cursor: pointer;
+  display: flex;
+  flex-direction: column;
+  border: 2px solid transparent;
+
+  &:hover, &:active {
+    border-color: $editor-green-highlight;
+  }
+}
+
+.learn-card-preview {
+  width: 100%;
+  aspect-ratio: 16 / 9;
+  background: white;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  overflow: hidden;
+
+  img {
+    width: 100%;
+    height: 100%;
+    object-fit: contain;
+  }
+}
+
+// Older Safari has no aspect-ratio support
+@supports not (aspect-ratio: 16 / 9) {
+  .learn-card-preview { height: 130px; }
+}
+
+.learn-card-placeholder {
+  font-size: 48px;
+  font-weight: bold;
+  color: $editor-modal-gray-secondary;
+}
+
+.learn-card-title {
+  font-size: 16px;
+  font-weight: bold;
+  color: $editor-modal-text-white;
+  padding: 8px 10px 2px 10px;
+}
+
+.learn-card-description {
+  font-size: 13px;
+  color: $editor-modal-text-dark;
+  padding: 2px 10px;
+}
+
+.learn-chips {
+  display: flex;
+  flex-wrap: wrap;
+  padding: 6px 8px 10px 8px;
+}
+
+.learn-chip {
+  border: 1px solid $editor-modal-gray-secondary;
+  background: transparent;
+  color: $editor-modal-text-gray;
+  font-size: 12px;
+  border-radius: 12px;
+  padding: 3px 9px;
+  margin: 2px;
+  cursor: pointer;
+}
+
+.learn-chip-active {
+  background: $editor-green-highlight;
+  border-color: $editor-green-highlight;
+  color: $editor-primary;
+}
+
+.learn-chip-tag {
+  cursor: default;
+  border-style: dashed;
+}
+
+.learn-filter-bar {
+  margin-bottom: 10px;
+  font-size: 14px;
+}
+
+.learn-link {
+  border: none;
+  background: transparent;
+  color: $editor-green-highlight;
+  font-size: 14px;
+  font-weight: bold;
+  padding: 4px 8px;
+  cursor: pointer;
+}
+
+.learn-empty {
+  padding: 40px 10px;
+  text-align: center;
+  color: $editor-modal-text-dark;
+  font-size: 16px;
+}
+
+.learn-principle {
+  background: $editor-modal-dark;
+  border-radius: 8px;
+  padding: 10px 12px;
+  margin-bottom: 10px;
+}
+
+.learn-principle-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.learn-principle-name {
+  font-size: 16px;
+  font-weight: bold;
+  color: $editor-modal-text-white;
+}
+
+.learn-principle-description {
+  font-size: 14px;
+  color: $editor-modal-text-dark;
+  margin-top: 4px;
+}
+
+.learn-principle-exercises {
+  display: flex;
+  flex-wrap: wrap;
+  margin-top: 8px;
+}
+
+.learn-principle-exercise {
+  display: flex;
+  align-items: center;
+  border: 1px solid $editor-modal-gray-secondary;
+  background: $editor-modal-gray;
+  color: $editor-modal-text-gray;
+  border-radius: 6px;
+  padding: 4px 10px 4px 4px;
+  margin: 3px;
+  font-size: 13px;
+  cursor: pointer;
+
+  img {
+    width: 44px;
+    height: 26px;
+    object-fit: contain;
+    background: white;
+    border-radius: 3px;
+    margin-right: 6px;
+  }
+}
