+
+/** Furthest any stroke point between two corners strays from the straight line joining them. */
+function edgeBend (pts, i, j) {
+  let a = pts[i], b = pts[j], worst = 0;
+  for (let k = i; k <= j; k++) worst = Math.max(worst, distToSegment(pts[k], a, b));
