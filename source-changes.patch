+ * comes back as the same stroke, smoothed out. Returns null if there's nothing to tidy.
+ */
+export function recognize (raw) {
+  let pts = raw.map(p => ({ x: p.x, y: p.y }));
+  pts = pts.filter((p, i) => i === 0 || dist(p, pts[i - 1]) > 0.5);
+  if (pts.length < 4) return null;
+  let xs = pts.map(p => p.x), ys = pts.map(p => p.y);
+  let minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
+  let minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
+  let size = Math.max(maxX - minX, maxY - minY);
+  if (size < 12) return null;
+  let first = pts[0], last = pts[pts.length - 1];
+  let length = 0;
+  for (let i = 1; i < pts.length; i++) length += dist(pts[i], pts[i - 1]);
+  let span = dist(first, last);
+
+  // A line: every point stays close to the line from start to end.
+  if (span > size * 0.8 && pts.every(p => distToSegment(p, first, last) < Math.max(4, span * 0.07))) {
+    return { type: 'line', from: first, to: last };
+  }
