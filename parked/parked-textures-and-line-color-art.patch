diff -ruN wick-next/src/Editor/Panels/Toolbox/ArtLayerSwitch/ArtLayerSwitch.jsx wick-editor/src/Editor/Panels/Toolbox/ArtLayerSwitch/ArtLayerSwitch.jsx
