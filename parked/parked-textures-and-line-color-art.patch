@@ -0,0 +1,92 @@
+/*
+ * Line / Color art switch for the toolbox.
+ * Picks which art layer new strokes go into, and shows or hides each kind on the canvas.
+ *
+ * This file is part of a modified version of Wick Editor and is licensed
+ * under the GNU General Public License v3 or later.
+ */
+
+import React, { Component } from 'react';
+import './_artlayerswitch.scss';
+
+const EyeIcon = ({ open }) => (
+  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
+    <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12z" fill="none" stroke="currentColor" strokeWidth="2" strokeLinejoin="round"/>
+    <circle cx="12" cy="12" r="3.2" fill="currentColor"/>
+    {!open && <line x1="3" y1="21" x2="21" y2="3" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round"/>}
+  </svg>
+);
+
+const LineIcon = () => (
+  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
+    <path d="M3 17c3-1 4-8 7-8s2 7 5 7 4-6 6-7" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round"/>
+  </svg>
+);
+
+const ColorIcon = () => (
+  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
+    <path d="M12 3c3.5 4.5 6 7.6 6 10.5A6 6 0 0 1 6 13.5C6 10.6 8.5 7.5 12 3z" fill="currentColor"/>
+  </svg>
+);
+
+class ArtLayerSwitch extends Component {
+  constructor (props) {
+    super(props);
+    this.state = this.readVisibility();
+  }
+
+  readVisibility () {
+    let art = window.Wick && window.Wick.ArtLayers;
+    return {
+      showLine: art ? art.showLine : true,
+      showColor: art ? art.showColor : true,
+    };
+  }
+
+  componentDidMount () {
+    if (window.Wick && window.Wick.ArtLayers) {
+      this.unsubscribe = window.Wick.ArtLayers.subscribe(() => this.setState(this.readVisibility()));
+    }
+  }
+
+  componentWillUnmount () {
+    if (this.unsubscribe) this.unsubscribe();
+  }
+
+  toggle = (type, e) => {
+    e.stopPropagation();
+    let visible = type === 'line' ? this.state.showLine : this.state.showColor;
+    window.Wick.ArtLayers.setVisible(type, !visible);
+  }
+
+  renderSegment = (type, label, Icon) => {
+    let active = (this.props.getToolSetting('artLayer') || 'line') === type;
+    let visible = type === 'line' ? this.state.showLine : this.state.showColor;
+    return (
+      <div
+        className={'art-layer-segment' + (active ? ' art-layer-segment-active' : '') + (visible ? '' : ' art-layer-segment-hidden')}
+        role='button'
+        title={'Draw on ' + label + ' Art'}
+        onClick={() => this.props.setToolSetting('artLayer', type)}>
+        <span className='art-layer-label'><Icon/>{label}</span>
+        <button
+          className='art-layer-eye'
+          title={(visible ? 'Hide ' : 'Show ') + label + ' Art'}
+          onClick={(e) => this.toggle(type, e)}>
+          <EyeIcon open={visible}/>
+        </button>
+      </div>
+    );
+  }
+
+  render () {
+    return (
+      <div className='art-layer-switch'>
+        {this.renderSegment('line', 'Line', LineIcon)}
+        {this.renderSegment('color', 'Color', ColorIcon)}
+      </div>
+    );
+  }
+}
+
+export default ArtLayerSwitch;
