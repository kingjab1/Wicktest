+@import 'Editor/_wickbrand.scss';
+
+.art-layer-switch {
+  display: flex;
+  align-items: center;
+  height: 34px;
+  margin: 0 6px;
+  padding: 2px;
+  border-radius: 9px;
+  background: $editor-modal-dark;
+  flex-shrink: 0;
+}
+
+.art-layer-segment {
+  display: flex;
+  align-items: center;
+  height: 100%;
+  padding: 0 2px 0 9px;
+  border-radius: 7px;
+  color: $editor-modal-text-dark;
+  font-size: 14px;
+  font-weight: bold;
+  cursor: pointer;
+  user-select: none;
+  -webkit-user-select: none;
+
+  svg { display: block; }
+}
+
+.art-layer-label {
+  display: flex;
+  align-items: center;
+
+  svg { margin-right: 4px; }
+}
+
+.art-layer-segment-active {
+  background: $editor-green-highlight;
+  color: $editor-primary;
+}
+
+.art-layer-segment-hidden .art-layer-label {
+  opacity: 0.45;
+}
+
+.art-layer-eye {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 30px;
+  height: 30px;
+  margin-left: 2px;
+  border: none;
+  border-radius: 6px;
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+  padding: 0;
+}
+
+.bucket-fills-color-toggle {
+  display: flex;
+  align-items: center;
+  height: 30px;
+  margin-left: 8px;
+  padding: 0 10px 0 6px;
+  border-radius: 8px;
+  background: $editor-modal-dark;
+  color: $editor-modal-text-gray;
+  font-size: 13px;
+  font-weight: bold;
+  cursor: pointer;
+  user-select: none;
+  -webkit-user-select: none;
+  white-space: nowrap;
+}
+
+.bucket-fills-color-box {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 18px;
+  height: 18px;
+  margin-right: 6px;
+  border-radius: 4px;
+  border: 2px solid $editor-modal-text-gray;
+  font-size: 13px;
+  line-height: 1;
+}
+
+.bucket-fills-color-on .bucket-fills-color-box {
+  background: $editor-green-highlight;
+  border-color: $editor-green-highlight;
+  color: $editor-primary;
+}
