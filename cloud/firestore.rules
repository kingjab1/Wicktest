rules_version = '2';

// Security rules for online saves (Cloud Firestore).
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
//
// Who can do what:
//   Developer (accounts listed in /admins, added by hand): can publish Learn examples, which everyone sees,
//     and can read or fix anything.
//   Teachers: anyone who signs up with their own email. They only see their own classes, students,
//     student work and class sounds.
//   Students: made by their teacher. They sign in with a class code, their picture and a PIN, and only see
//     their own projects and their teacher's class sounds.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function dataAt(path) { return get(path).data; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function isTeacher() { return signedIn() && exists(/databases/$(database)/documents/teachers/$(me())); }
    function isStudent() { return signedIn() && exists(/databases/$(database)/documents/students/$(me())); }
    function studentInfo() { return dataAt(/databases/$(database)/documents/students/$(me())); }
    function studentTeacher() { return studentInfo().teacher; }
    function ownsClass(classId) {
      return isTeacher() && dataAt(/databases/$(database)/documents/classes/$(classId)).teacher == me();
    }
    function studentEmail() {
      return request.auth.token.email != null && request.auth.token.email.matches('.*@student[.]animate[.]invalid$');
    }

    // The developer. Add yourself by hand in the console (document ID = your account's UID).
    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }

    // Anyone with a real email can make themselves a teacher. Student logins can't.
    match /teachers/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow create: if signedIn() && me() == uid && !studentEmail();
      allow update, delete: if isAdmin();
    }

    // The document ID is the class code. Anyone can look up one class by its code (it only holds picture names),
    // but only the class's teacher can list their classes.
    match /classes/{classId} {
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.teacher == me());
      allow create: if isTeacher() && request.resource.data.teacher == me();
      allow update: if isAdmin()
        || (isTeacher() && resource.data.teacher == me() && request.resource.data.teacher == me());
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacher == me());
    }

    // PINs, so login cards can be reprinted.
    match /classSecrets/{classId} {
      allow read, write: if isAdmin() || ownsClass(classId);
    }

    match /students/{uid} {
      allow read: if isAdmin() || (signedIn() && (me() == uid || resource.data.teacher == me()));
      allow create: if isTeacher() && request.resource.data.teacher == me() && ownsClass(request.resource.data.classId);
      allow update: if isAdmin() || (isTeacher() && resource.data.teacher == me() && request.resource.data.teacher == me());
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacher == me());
    }

    match /projects/{id} {
      function project() { return dataAt(/databases/$(database)/documents/projects/$(id)); }
      function canSeeProject() {
        return isAdmin() || (signedIn() && (project().owner == me() || project().teacher == me()));
      }

      // resource == null lets the app check whether a new project already exists.
      allow read: if isAdmin()
        || (signedIn() && (resource == null || resource.data.owner == me() || resource.data.teacher == me()));
      allow create: if signedIn() && request.resource.data.owner == me() && (
          (isStudent() && request.resource.data.classId == studentInfo().classId
            && request.resource.data.teacher == studentTeacher())
          || (isTeacher() && request.resource.data.teacher == me()));
      allow update: if isAdmin()
        // the owner saving again
        || (signedIn() && resource.data.owner == me() && request.resource.data.owner == me()
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.teacher == resource.data.teacher)
        // the teacher moving work to a student's new login after a PIN reset
        || (isTeacher() && resource.data.teacher == me() && request.resource.data.teacher == me()
            && request.resource.data.classId == resource.data.classId);
      allow delete: if isAdmin() || (signedIn() && (resource.data.owner == me() || resource.data.teacher == me()));

      match /chunks/{chunk} {
        allow read: if canSeeProject();
        allow write: if isAdmin() || (signedIn() && project().owner == me());
      }
    }

    // Learn examples: only the developer publishes, everyone sees them.
    match /learn/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /chunks/{chunk} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Icons the developer replaced: everyone's app reads them, only the developer changes them.
    match /siteIcons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Class Sounds belong to one teacher. Their students can hear and use them.
    match /classSounds/{id} {
      function sound() { return dataAt(/databases/$(database)/documents/classSounds/$(id)); }
      function canHear(teacher) {
        return isAdmin() || (signedIn() && (teacher == me() || (isStudent() && teacher == studentTeacher())));
      }

      allow read: if canHear(resource.data.teacher);
      allow create: if isTeacher() && request.resource.data.teacher == me();
      allow update: if isAdmin() || (isTeacher() && resource.data.teacher == me() && request.resource.data.teacher == me());
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacher == me());
      match /chunks/{chunk} {
        allow read: if canHear(sound().teacher);
        allow write: if isAdmin() || (isTeacher() && sound().teacher == me());
      }
    }
  }
}
